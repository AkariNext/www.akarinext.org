# PocketBase の API 接続先（SSR / monitor がサーバー側でのみ使う）
# 本番では公開せず、コンテナ内部のホスト名を指すことを推奨（例: http://pocketbase:8090）
POCKETBASE_URL=http://localhost:8090

# ブラウザが画像を取りに行くベース URL
# 本番はリバースプロキシで /api/files/* を PocketBase に転送し、/api/files を指定する
# ローカルでプロキシを立てない場合は http://localhost:8090/api/files を指定する
PUBLIC_MEDIA_BASE=http://localhost:8090/api/files
