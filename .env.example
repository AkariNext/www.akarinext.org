# PocketBase の API 接続先（SSR / monitor がサーバー側でのみ使う）
# 本番では公開せず、コンテナ内部のホスト名を指すことを推奨（例: http://pocketbase:8090）
POCKETBASE_URL=http://localhost:8090

# ブラウザが画像を取りに行くベース URL
# 本番はリバースプロキシで /api/files/* を PocketBase に転送し、/api/files を指定する
# ローカルでプロキシを立てない場合は http://localhost:8090/api/files を指定する
PUBLIC_MEDIA_BASE=http://localhost:8090/api/files

# --- サーバー監視 (scripts/monitor.ts) ---
# InfluxDB へのメトリクス記録に必要（未設定なら ping 監視は動かない）
# INFLUX_URL=http://localhost:8086
# INFLUX_TOKEN=
# INFLUX_ORG=akarinext
# INFLUX_BUCKET=server_metrics

# HTTP 外形監視の対象（カンマ区切り）。Traefik が落ちると全サイトが 502 になるが
# TCP は Cloudflare が受けてしまうため、ステータスコードで判定する
MONITOR_HTTP_TARGETS=https://www.akarinext.org/,https://pb.akarinext.org/api/health
# MONITOR_HTTP_INTERVAL_MS=60000   # チェック間隔（既定 60 秒）
# MONITOR_ALERT_AFTER=2            # 何回連続で失敗したら通知するか（既定 2）
# DISCORD_WEBHOOK_ALERTS=          # 未設定ならログ出力のみ
