---
import { ArrowLeft } from "lucide-astro";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;

const reason = Astro.url.searchParams.get("reason") || "";
const messages: Record<string, { title: string; detail: string }> = {
	provider: {
		title: "Discord ログインが有効になっていません",
		detail:
			"PocketBase の管理画面で users コレクションに Discord プロバイダを設定してください。",
	},
	denied: {
		title: "ログインがキャンセルされました",
		detail: "Discord 側で許可されなかったため、ログインは完了していません。",
	},
	state: {
		title: "ログインの有効期限が切れました",
		detail:
			"時間が経ちすぎたか、途中でページを離れた可能性があります。もう一度やり直してください。",
	},
	exchange: {
		title: "ログインに失敗しました",
		detail:
			"Discord との認証は通りましたが、アカウントの引き換えに失敗しました。時間をおいて試してください。",
	},
};
const message = messages[reason] || {
	title: "ログインに失敗しました",
	detail: "もう一度お試しください。",
};
Astro.response.status = 400;
---

<Layout title={message.title} noindex={true}>
  <div class="auth-error container">
    <p>Sign in</p>
    <h1>{message.title}</h1>
    <p class="auth-error__detail">{message.detail}</p>
    <div class="auth-error__actions">
      <a href="/auth/login">もう一度ログインする</a>
      <a href="/" class="auth-error__back"><ArrowLeft aria-hidden="true" />トップへ戻る</a>
    </div>
  </div>
</Layout>

<style>
  .auth-error { display: grid; justify-items: start; gap: var(--space-lg); padding-block: var(--space-4xl); }
  .auth-error > p:first-child { color: var(--color-accent); font-weight: 700; }
  .auth-error h1 { max-width: 20ch; font-size: var(--text-2xl); line-height: 1.2; letter-spacing: -0.02em; }
  .auth-error__detail { max-width: 56ch; color: var(--color-ink-2); line-height: 1.8; }
  .auth-error__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-lg); }
  .auth-error__actions a { min-height: 2.75rem; padding-block: var(--space-sm); border-block-end: var(--rule-hair) solid var(--color-accent); color: var(--color-accent); white-space: nowrap; }
  .auth-error__back { display: inline-flex; align-items: center; gap: var(--space-xs); border-block-end-color: transparent !important; color: var(--color-muted) !important; }
  .auth-error__back svg { width: 1em; height: 1em; }
</style>
