---
import { ArrowLeft, Eye, Github, Globe, MessageSquare, Shield, Twitch, Twitter, User, Youtube } from "lucide-astro";
import Layout from "../../layouts/Layout.astro";
import { cmsClient, getMediaUrl, type CmsPost } from "../../lib/cms";
import { markdownToHtml } from "../../lib/richtext";
export const prerender = false;
const { slug } = Astro.params;
let post: CmsPost | null = null;
try {
  const value = (slug || "").trim();
  let found = value ? await cmsClient.items<CmsPost>("posts").readByQuery({ limit: 1, where: { slug: { equals: value } } }) : [];
  if (!found.length && value) found = await cmsClient.items<CmsPost>("posts").readByQuery({ limit: 1, where: { id: { equals: value } } });
  post = found[0] || null;
} catch (error) { console.error("Error fetching post", error); }
if (!post) {
  Astro.response.status = 404;
  return new Response("記事が見つかりませんでした", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
}
const content = await markdownToHtml(post.content);
const image = getMediaUrl(post.image);
const published = post.published_date || post.createdAt;
const formatted = new Date(published).toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
const author = typeof post.author === "object" && post.author ? post.author : null;
const authorName = author?.name || author?.username || "AkariNext";
const authorImage = getMediaUrl(author?.avatar);
const readMinutes = Math.max(1, Math.ceil((post.content?.length || 0) / 500));
const socialIcon = (platform?: string) => ({ twitter: Twitter, x: Twitter, github: Github, twitch: Twitch, youtube: Youtube, discord: MessageSquare }[platform?.toLowerCase() || ""] || Globe);
const canonicalPath = `/posts/${post.slug || post.id}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  datePublished: new Date(published).toISOString(),
  dateModified: new Date(post.updatedAt).toISOString(),
  mainEntityOfPage: new URL(canonicalPath, "https://www.akarinext.org").href,
  author: { "@type": "Person", name: authorName, ...(author ? { url: new URL(`/users/${author.id}`, "https://www.akarinext.org").href } : {}) },
  publisher: { "@type": "Organization", name: "AkariNext", url: "https://www.akarinext.org/" },
  ...(image ? { image: [image] } : {}),
};
---
<Layout title={post.title} description={post.is_spoiler ? post.spoiler_warning || "この記事にはネタバレが含まれています。" : post.content?.replace(/<[^>]*>/g, "").slice(0, 160)} image={image || undefined} canonical={canonicalPath} ogType="article" structuredData={structuredData}>
  <article class="reading-page">
    <header class="reading-head container">
      <a href="/posts" class="back-link"><ArrowLeft aria-hidden="true" />記事一覧</a>
      <div class="reading-meta"><time datetime={published}>{formatted}</time><span>{readMinutes}分で読めます</span>{post.category && <span>{post.category}</span>}</div>
      <h1>{post.title}</h1>
      {author && <a href={`/users/${author.id}`} class="byline">
        {authorImage ? <img src={authorImage} alt="" /> : <span class="byline-placeholder"><User aria-hidden="true" /></span>}
        <span><small>Written by</small><strong>{authorName}</strong></span>
      </a>}
    </header>

    {image && <figure class="article-figure container"><img src={image} alt={post.title} fetchpriority="high" decoding="async" /></figure>}

    <div class="article-body container">
      <div class:list={["prose-wrapper", { "is-concealed": post.is_spoiler }]} id="post-content-wrapper"><div class="prose" set:html={content}></div></div>
      {post.is_spoiler && <aside class="spoiler-notice" id="spoiler-overlay"><Shield aria-hidden="true" /><h2>ネタバレを含みます</h2><p>{post.spoiler_warning || "この記事にはネタバレが含まれています。"}</p><button type="button" id="btn-reveal-spoiler"><Eye aria-hidden="true" />内容を表示</button></aside>}

      {post.tags && post.tags.length > 0 && <nav class="article-tags" aria-label="記事タグ">{post.tags.map((tag) => <a href={`/tags/${tag.slug}`}>#{tag.name}</a>)}</nav>}

      {author && <aside class="author-note">
        <div class="author-note__identity">{authorImage ? <img src={authorImage} alt="" /> : <span class="byline-placeholder"><User aria-hidden="true" /></span>}<div><h2>{authorName}</h2>{author.staff_title && <p>{author.staff_title}</p>}</div></div>
        <p>{author.bio || "この著者のプロフィールはまだ登録されていません。"}</p>
        <div class="author-note__links"><a href={`/users/${author.id}`}>すべての記事</a>{author.social_links?.map((link) => { const Icon = socialIcon(link.platform); return link.url && <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.platform || "外部プロフィール"}><Icon aria-hidden="true" /></a>; })}</div>
      </aside>}
    </div>
  </article>
  <script>
    const button = document.querySelector<HTMLButtonElement>("#btn-reveal-spoiler");
    const wrapper = document.querySelector("#post-content-wrapper");
    const notice = document.querySelector("#spoiler-overlay");
    button?.addEventListener("click", () => { wrapper?.classList.remove("is-concealed"); notice?.remove(); });
  </script>
</Layout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app */
  .reading-page { padding-block: var(--space-2xl) var(--space-4xl); }
  .reading-head { display: grid; gap: var(--space-lg); max-width: 72rem; }
  .back-link { display: inline-flex; align-items: center; justify-self: start; gap: var(--space-xs); min-height: 2.75rem; color: var(--color-accent); white-space: nowrap; }
  .back-link svg { width: 1em; }
  .reading-meta { display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-lg); padding-block-start: var(--space-lg); border-block-start: var(--rule-medium) solid var(--color-ink); color: var(--color-muted); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .reading-head h1 { max-width: 20ch; font-size: clamp(2.6rem, 6vw, 4.8rem); line-height: 1.08; letter-spacing: -0.04em; overflow-wrap: anywhere; min-width: 0; }
  .byline { display: inline-flex; align-items: center; justify-self: start; gap: var(--space-sm); min-height: 3rem; }
  .byline img, .byline-placeholder { display: grid; width: 3rem; height: 3rem; place-items: center; object-fit: cover; border-radius: 50%; background: var(--color-paper-2); }
  .byline-placeholder svg { width: 1.2rem; }
  .byline > span:last-child { display: grid; }
  .byline small { color: var(--color-muted); }
  .article-figure { margin-block-start: var(--space-2xl); }
  .article-figure img { width: 100%; max-height: 42rem; object-fit: cover; }
  .article-body { position: relative; max-width: 78rem; padding-block-start: var(--space-3xl); }
  .prose-wrapper { max-width: 46rem; margin-inline: auto; }
  .is-concealed { filter: blur(var(--space-xs)); pointer-events: none; user-select: none; }
  .spoiler-notice { position: absolute; inset-block-start: var(--space-3xl); inset-inline: 50% auto; display: grid; width: min(90%, 32rem); transform: translateX(-50%); justify-items: start; gap: var(--space-md); padding: var(--space-xl); border: var(--rule-medium) solid var(--color-ink); background: var(--color-paper); color: var(--color-ink); }
  .spoiler-notice > svg { width: var(--space-lg); color: var(--color-accent); }
  .spoiler-notice button { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; padding-inline: var(--space-md); border: var(--rule-hair) solid var(--color-ink); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-ink); cursor: pointer; }
  .spoiler-notice button svg { width: 1em; }
  .article-tags { display: flex; flex-wrap: wrap; gap: var(--space-md); max-width: 46rem; margin-inline: auto; padding-block: var(--space-2xl); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .article-tags a { color: var(--color-accent); white-space: nowrap; }
  .author-note { display: grid; gap: var(--space-lg); max-width: 46rem; margin-inline: auto; padding-block-start: var(--space-2xl); }
  .author-note__identity { display: flex; align-items: center; gap: var(--space-md); }
  .author-note__identity img { width: 4rem; height: 4rem; border-radius: 50%; object-fit: cover; }
  .author-note > p { max-width: 65ch; color: var(--color-ink-2); line-height: 1.8; }
  .author-note__links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-lg); }
  .author-note__links a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--color-accent); white-space: nowrap; }
  .author-note__links svg { width: 1.1rem; }
  @media (hover: hover) and (pointer: fine) { .back-link:hover, .byline:hover, .article-tags a:hover, .author-note__links a:hover { color: var(--color-accent); } .spoiler-notice button:hover { background: var(--color-paper-2); } }
  .spoiler-notice button:active, .back-link:active { transform: translateY(1px); }
  .spoiler-notice button:disabled { cursor: not-allowed; opacity: 0.5; }
  @media (max-width: 39.99rem) { .reading-page { padding-block-start: var(--space-xl); } .article-body { padding-block-start: var(--space-2xl); } .spoiler-notice { inset-block-start: var(--space-2xl); } }
</style>
