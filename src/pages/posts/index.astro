---
import Pagination from "../../components/Pagination.astro";
import PostIndexList from "../../components/PostIndexList.astro";
import Layout from "../../layouts/Layout.astro";
import { type CmsPost, type CmsTag, cmsClient } from "../../lib/cms";

const resolveLegacyTag = async (value: string) => {
	const tags = await cmsClient
		.items<CmsTag>("tags")
		.readByQuery({ limit: 200 });
	return (
		tags.find((item) => item.slug === value || item.name === value)?.slug ||
		value
	);
};
const legacyTag = Astro.url.searchParams.get("tag")?.trim();
const resolvedLegacyTag = legacyTag
	? await resolveLegacyTag(legacyTag).catch((error) => {
			console.error("[Posts] Error resolving legacy tag URL", error);
			return legacyTag;
		})
	: null;
if (resolvedLegacyTag)
	return Astro.redirect(`/tags/${encodeURIComponent(resolvedLegacyTag)}`, 301);

const page = Math.max(
	1,
	Number.parseInt(Astro.url.searchParams.get("page") || "1", 10) || 1,
);
const perPage = 10;
let result = {
	items: [] as CmsPost[],
	page,
	perPage,
	totalItems: 0,
	totalPages: 0,
};
try {
	result = await cmsClient.items<CmsPost>("posts").readPage({
		page,
		perPage,
		sort: ["-published_date", "-createdAt", "-id"],
	});
} catch (error) {
	console.error("[Posts] Error fetching data", error);
}

const outOfRange =
	page > 1 && (result.totalPages === 0 || page > result.totalPages);
if (outOfRange) {
	Astro.response.status = 404;
	Astro.response.statusText = "Not Found";
}
const title = outOfRange
	? "記事ページが見つかりません"
	: page > 1
		? `記事一覧 ${page}ページ目`
		: "記事";
const description = outOfRange
	? "指定された記事一覧ページは見つかりませんでした。"
	: page > 1
		? `AkariNextの記事一覧、${page}ページ目です。`
		: "メンバーが書いた開発、ゲーム、活動の記録";
const canonical = page === 1 ? "/posts" : `/posts?page=${page}`;
---

<Layout title={title} description={description} canonical={canonical} noindex={outOfRange}>
  <div class="posts-index container">
    <header class="posts-index__head">
      <p>AkariNext Journal</p>
      <h1>{outOfRange ? "ページが見つかりません" : "記事"}</h1>
      <div class="posts-index__summary"><p>{outOfRange ? "指定されたページは存在しないか、移動した可能性があります。" : "開発の途中で見つけたこと、遊んだゲームの記録、コミュニティーの日常。新しい順に掲載しています。"}</p>{!outOfRange && <span>{result.totalItems} 本</span>}</div>
    </header>
    <PostIndexList posts={outOfRange ? [] : result.items} emptyMessage={outOfRange ? "指定されたページは見つかりませんでした" : undefined} />
    {!outOfRange && <Pagination page={result.page} totalPages={result.totalPages} basePath="/posts" />}
  </div>
</Layout>

<style>
  .posts-index { padding-block: var(--space-2xl) var(--space-4xl); }
  .posts-index__head { display: grid; gap: var(--space-lg); padding-block-end: var(--space-2xl); border-block-end: var(--rule-medium) solid var(--color-ink); }
  .posts-index__head > p { color: var(--color-accent); font-weight: 700; }
  .posts-index__head h1 { font-size: var(--text-display); line-height: 1; letter-spacing: -0.04em; overflow-wrap: anywhere; min-width: 0; }
  .posts-index__summary { display: grid; gap: var(--space-md); align-items: end; }
  .posts-index__summary p { max-width: 58ch; color: var(--color-ink-2); font-size: var(--text-md); line-height: 1.8; }
  .posts-index__summary span { color: var(--color-muted); font-variant-numeric: tabular-nums; }
  @media (min-width: 40rem) { .posts-index__summary { grid-template-columns: minmax(0, 1fr) auto; } }
  @media (max-width: 39.99rem) { .posts-index { padding-block-start: var(--space-xl); } }
</style>
