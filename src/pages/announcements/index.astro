---
import { BellRing } from "lucide-astro";
import Layout from "../../layouts/Layout.astro";
import { cmsClient, type CmsAnnouncement } from "../../lib/cms";
import { markdownToHtml } from "../../lib/richtext";

export const prerender = false;

let processedAnnouncements: (CmsAnnouncement & { processedContent: string })[] = [];

try {
  const announcements = await cmsClient.items<CmsAnnouncement>("announcements").readByQuery({ sort: ["-published_date", "-createdAt"], limit: 50 });
  processedAnnouncements = await Promise.all(announcements.map(async (announcement) => ({
    ...announcement,
    processedContent: announcement.content ? await markdownToHtml(announcement.content) : "",
  })));
} catch (error) {
  console.error("Error fetching announcements:", error);
}

const announcementDate = (announcement: CmsAnnouncement) => announcement.published_date || announcement.createdAt;
const formatDate = (value: string) => new Date(value).toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
---

<Layout title="お知らせ" description="AkariNextからのお知らせと更新情報">
  <div class="announcements-index container">
    <header class="announcements-index__head">
      <p>AkariNext Bulletin</p>
      <h1>お知らせ</h1>
      <div class="announcements-index__summary">
        <p>コミュニティーからの連絡、イベント、メンテナンスなどの更新情報です。</p>
        <span>{processedAnnouncements.length} 件</span>
      </div>
    </header>

    {processedAnnouncements.length > 0 ? (
      <div class="announcement-list">
        {processedAnnouncements.map((announcement) => {
          const date = announcementDate(announcement);
          return (
            <article id={`ann-${announcement.id}`} class="announcement-entry">
              <time datetime={date}>{formatDate(date)}</time>
              <div class="announcement-entry__content">
                <h2>{announcement.title}</h2>
                <div class="announcement-body prose" set:html={announcement.processedContent} />
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="announcements-empty"><BellRing aria-hidden="true" /><h2>まだお知らせはありません</h2><p>新しい情報が追加されるまでお待ちください。</p></div>
    )}
  </div>
</Layout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Bulletin index · design-system: design.md · designed-as-app */
  .announcements-index { padding-block: var(--space-2xl) var(--space-4xl); }
  .announcements-index__head { display: grid; gap: var(--space-lg); padding-block-end: var(--space-2xl); border-block-end: var(--rule-medium) solid var(--color-ink); }
  .announcements-index__head > p { color: var(--color-accent); font-weight: 700; }
  .announcements-index__head h1 { font-size: var(--text-display); line-height: 1; letter-spacing: -0.04em; }
  .announcements-index__summary { display: grid; gap: var(--space-md); align-items: end; }
  .announcements-index__summary p { max-width: 58ch; color: var(--color-ink-2); font-size: var(--text-md); line-height: 1.8; }
  .announcements-index__summary span { color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .announcement-entry { display: grid; gap: var(--space-lg); padding-block: var(--space-2xl); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .announcement-entry:last-child { border-block-end: 0; }
  .announcement-entry > time { color: var(--color-muted); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .announcement-entry__content { display: grid; min-width: 0; gap: var(--space-lg); }
  .announcement-entry h2 { max-width: 30ch; font-size: var(--text-xl); line-height: 1.35; overflow-wrap: anywhere; }
  .announcement-body { max-width: 46rem; margin: 0; color: var(--color-ink-2); }
  .announcement-body :global(h1), .announcement-body :global(h2), .announcement-body :global(h3) { margin-block: var(--space-xl) var(--space-md); color: var(--color-ink); font-size: var(--text-md); line-height: 1.5; }
  .announcement-body :global(p), .announcement-body :global(ul), .announcement-body :global(ol), .announcement-body :global(blockquote) { margin-block: 0 var(--space-md); line-height: 1.9; }
  .announcement-body :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.18em; }
  .announcement-body :global(img) { max-width: 100%; height: auto; margin-block: var(--space-lg); }
  .announcement-body :global(hr) { margin-block: var(--space-xl); border: 0; border-block-start: var(--rule-hair) solid var(--color-rule); }
  .announcements-empty { display: grid; justify-items: start; gap: var(--space-md); padding-block: var(--space-3xl); }
  .announcements-empty svg { width: var(--space-xl); color: var(--color-muted); }
  .announcements-empty p { color: var(--color-muted); }
  @media (min-width: 40rem) { .announcements-index__summary { grid-template-columns: minmax(0, 1fr) auto; } .announcement-entry { grid-template-columns: 9rem minmax(0, 1fr); } }
  @media (max-width: 39.99rem) { .announcements-index { padding-block-start: var(--space-xl); } .announcement-entry { padding-block: var(--space-xl); } }
</style>
