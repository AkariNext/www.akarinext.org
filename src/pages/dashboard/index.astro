---
import {
	Edit3,
	Gamepad2,
	LogOut,
	PenLine,
	Plus,
	Save,
	Trash2,
	User,
} from "lucide-astro";
import Layout from "../../layouts/Layout.astro";
import { cmsClient, getMediaUrl } from "../../lib/cms";
import type { CmsGame, CmsGameEntry, CmsPost } from "../../lib/cms-types";
import {
	getDashboardToken,
	listOwnGameEntries,
	listOwnPosts,
} from "../../lib/dashboard.server";

export const prerender = false;
const user = Astro.locals.user;
if (!user) return Astro.redirect("/auth/login?next=/dashboard", 302);

let posts: CmsPost[] = [],
	entries: CmsGameEntry[] = [],
	games: CmsGame[] = [];
let loadError = "";
try {
	const token = getDashboardToken(Astro.cookies);
	[posts, entries, games] = await Promise.all([
		listOwnPosts(token, user.id),
		listOwnGameEntries(token, user.id),
		cmsClient.items<CmsGame>("games").readByQuery({ sort: "name", limit: 500 }),
	]);
} catch (cause) {
	console.error("[Dashboard] Error loading dashboard", cause);
	loadError =
		"管理データを読み込めませんでした。PocketBase のマイグレーション適用状況を確認してください。";
}

const avatar = getMediaUrl(user.avatar);
const displayName = user.name || user.username || "メンバー";
const registeredGames = new Set(entries.map((entry) => entry.game.id));
const availableGames = games.filter((game) => !registeredGames.has(game.id));
const notices: Record<string, string> = {
	"post-deleted": "記事を削除しました。",
	"game-added": "ゲームを追加しました。",
	"game-saved": "ゲーム情報を保存しました。",
	"game-deleted": "ゲームを削除しました。",
};
const notice = notices[Astro.url.searchParams.get("notice") ?? ""];
const error = Astro.url.searchParams.get("error") || loadError;
const skillOptions = [
	["", "未設定"],
	["casual", "気軽に"],
	["intermediate", "慣れている"],
	["expert", "熟練"],
	["better_than_you", "かなり得意"],
] as const;
const impressionOptions = [
	["", "未設定"],
	["obsessed", "夢中"],
	["love", "大好き"],
	["like", "好き"],
	["meh", "普通"],
	["give_up", "断念"],
] as const;
const recruitmentOptions = [
	["", "募集なし"],
	["looking_for_group", "一緒に遊ぶ人を募集中"],
	["invite_anytime", "いつでも誘って"],
	["need_hints", "ヒントがほしい"],
	["can_teach", "教えられます"],
	["discussion_welcome", "話したい"],
] as const;
const date = new Intl.DateTimeFormat("ja-JP", {
	year: "numeric",
	month: "short",
	day: "numeric",
});
---

<Layout title="ダッシュボード" noindex={true}>
  <main class="dashboard container">
    <header class="dashboard__head">
      <p>Dashboard</p>
      <div class="dashboard__identity">
        {avatar ? <img src={avatar} alt="" width="64" height="64" /> : <span class="dashboard__avatar"><User aria-hidden="true" /></span>}
        <div><h1>{displayName}</h1><p>{user.staff_title || (user.is_staff ? "運営メンバー" : "メンバー")}</p></div>
      </div>
      <nav class="dashboard__actions" aria-label="アカウント操作">
        <a href={`/users/${user.id}`}>公開プロフィール</a>
        <form method="POST" action="/auth/logout"><button type="submit"><LogOut aria-hidden="true" />ログアウト</button></form>
      </nav>
    </header>

    {(notice || error) && <p class:list={["dashboard__message", { "dashboard__message--error": error }]} role={error ? "alert" : "status"}>{error || notice}</p>}

    <section class="dashboard__section" aria-labelledby="posts-heading">
      <header class="dashboard__section-head">
        <div><p>Writing</p><h2 id="posts-heading"><PenLine aria-hidden="true" />記事</h2></div>
        <a class="primary" href="/dashboard/posts/new"><Plus aria-hidden="true" />新しい記事</a>
      </header>
      {posts.length ? <ol class="post-index">{posts.map((post) => <li>
        <div class="post-index__meta"><span class:list={["status", { "status--live": post.status === "published" }]}>{post.status === "published" ? "公開" : "下書き"}</span><time datetime={post.updatedAt}>{date.format(new Date(post.updatedAt))} 更新</time></div>
        <h3>{post.title}</h3><a href={`/dashboard/posts/${post.id}`}><Edit3 aria-hidden="true" />編集</a>
      </li>)}</ol> : <div class="empty"><p>まだ記事はありません。下書きから始められます。</p><a href="/dashboard/posts/new">最初の記事を書く</a></div>}
    </section>

    <section class="dashboard__section" id="games" aria-labelledby="games-heading">
      <header class="dashboard__section-head"><div><p>Game shelf</p><h2 id="games-heading"><Gamepad2 aria-hidden="true" />ゲーム</h2></div><span>{entries.length} タイトル</span></header>
      {entries.length ? <div class="game-index">{entries.map((entry) => <form method="POST" action="/api/dashboard/games" class="game-row">
        <input type="hidden" name="id" value={entry.id} />
        <div class="game-row__identity">{entry.game.cover_image ? <img src={entry.game.cover_image.url} alt="" width="72" height="96" loading="lazy" /> : <span aria-hidden="true"><Gamepad2 /></span>}<h3>{entry.game.name}</h3></div>
        <label><span>状態</span><select name="list"><option value="playing" selected={entry.list === "playing"}>プレイ中</option><option value="finished" selected={entry.list === "finished"}>プレイ終了</option></select></label>
        <label><span>遊び方</span><select name="skill_level">{skillOptions.map(([value, label]) => <option value={value} selected={entry.skill_level === value}>{label}</option>)}</select></label>
        <label><span>感想</span><select name="impression">{impressionOptions.map(([value, label]) => <option value={value} selected={entry.impression === value}>{label}</option>)}</select></label>
        <label><span>募集</span><select name="recruitment">{recruitmentOptions.map(([value, label]) => <option value={value} selected={entry.recruitment === value}>{label}</option>)}</select></label>
        <div class="game-row__actions"><button type="submit" name="_action" value="update"><Save aria-hidden="true" />保存</button><button class="delete" type="submit" name="_action" value="delete"><Trash2 aria-hidden="true" />削除</button></div>
      </form>)}</div> : <p class="empty">まだゲームは登録されていません。</p>}

      <details class="game-add"><summary><Plus aria-hidden="true" />ゲームを追加</summary>
        <form method="POST" action="/api/dashboard/games">
          <label><span>ゲーム</span><select name="game" required><option value="">選択してください</option>{availableGames.map((game) => <option value={game.id}>{game.name}</option>)}</select></label>
          <label><span>状態</span><select name="list"><option value="playing">プレイ中</option><option value="finished">プレイ終了</option></select></label>
          <label><span>遊び方</span><select name="skill_level">{skillOptions.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
          <label><span>感想</span><select name="impression">{impressionOptions.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
          <label><span>募集</span><select name="recruitment">{recruitmentOptions.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
          <button type="submit" disabled={availableGames.length === 0}><Plus aria-hidden="true" />追加</button>
        </form>{availableGames.length === 0 && <p>追加できるゲームはありません。</p>}
      </details>
    </section>
  </main>
</Layout>

<style>
  /* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 · genre: editorial · macrostructure: Index-First · tone: practical cool blue · contrast: pass (40–41) */
  .dashboard { padding-block: var(--space-xl) var(--space-4xl); }
  .dashboard__head { display: grid; gap: var(--space-lg); padding-block-end: var(--space-xl); border-block-end: var(--rule-medium) solid var(--color-ink); }
  .dashboard__head > p, .dashboard__section-head div > p { color: var(--color-accent); font-size: var(--text-sm); font-weight: 700; }
  .dashboard__identity { display: flex; align-items: center; gap: var(--space-md); }
  .dashboard__identity img, .dashboard__avatar { display: grid; width: 4rem; height: 4rem; flex: 0 0 4rem; place-items: center; overflow: hidden; border-radius: 50%; object-fit: cover; background: var(--color-paper-2); color: var(--color-muted); }
  .dashboard__avatar svg { width: 1.5rem; height: 1.5rem; }
  .dashboard__identity h1 { font-size: var(--text-2xl); line-height: 1.1; letter-spacing: -.02em; overflow-wrap: anywhere; }
  .dashboard__identity div > p { color: var(--color-muted); font-size: var(--text-sm); }
  .dashboard__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-lg); }
  .dashboard__actions a { display: inline-flex; min-height: 2.75rem; align-items: center; border-block-end: var(--rule-hair) solid var(--color-accent); color: var(--color-accent); white-space: nowrap; }
  button, .primary { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; gap: var(--space-xs); padding-inline: var(--space-md); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-ink); cursor: pointer; white-space: nowrap; }
  button svg, .primary svg { width: 1em; height: 1em; }
  button:disabled { cursor: not-allowed; opacity: .55; }
  .primary, .game-add button { border-color: var(--color-accent); background: var(--color-accent); color: var(--color-accent-ink); }
  .dashboard__message { margin-block-start: var(--space-lg); padding: var(--space-sm) var(--space-md); border: var(--rule-hair) solid var(--color-success); }
  .dashboard__message--error { border-color: var(--color-error); }
  .dashboard__section { display: grid; gap: var(--space-lg); padding-block: var(--space-2xl); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .dashboard__section:last-child { border-block-end: 0; }
  .dashboard__section-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-md); }
  .dashboard__section-head h2 { display: flex; align-items: center; gap: var(--space-xs); margin-block-start: var(--space-xs); font-size: var(--text-xl); line-height: 1.15; }
  .dashboard__section-head h2 svg { width: 1em; height: 1em; color: var(--color-accent); }
  .dashboard__section-head > span { color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .post-index { list-style: none; border-block-start: var(--rule-hair) solid var(--color-rule); }
  .post-index li { display: grid; gap: var(--space-sm); padding-block: var(--space-lg); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .post-index__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); color: var(--color-muted); font-size: var(--text-xs); }
  .status { padding: var(--space-3xs) var(--space-xs); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); }
  .status--live { border-color: var(--color-success); color: var(--color-success); }
  .post-index h3 { min-width: 0; font-size: var(--text-md); line-height: 1.35; overflow-wrap: anywhere; }
  .post-index li > a { display: inline-flex; width: fit-content; min-height: 2.75rem; align-items: center; gap: var(--space-xs); color: var(--color-accent); white-space: nowrap; }
  .post-index li > a svg { width: 1em; height: 1em; }
  .empty { display: grid; max-width: 65ch; gap: var(--space-sm); color: var(--color-muted); }
  .empty a { width: fit-content; color: var(--color-accent); border-block-end: var(--rule-hair) solid currentColor; }
  .game-index { border-block-start: var(--rule-hair) solid var(--color-rule); }
  .game-row { display: grid; gap: var(--space-md); padding-block: var(--space-lg); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .game-row__identity { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); align-items: center; gap: var(--space-md); }
  .game-row__identity img, .game-row__identity > span { display: grid; width: 4.5rem; aspect-ratio: 3 / 4; place-items: center; object-fit: cover; background: var(--color-paper-2); color: var(--color-muted); }
  .game-row__identity > span svg { width: 1.5rem; height: 1.5rem; }
  .game-row h3 { font-size: var(--text-md); line-height: 1.3; overflow-wrap: anywhere; }
  .game-row label, .game-add label { display: grid; gap: var(--space-xs); }
  .game-row label > span, .game-add label > span { color: var(--color-muted); font-size: var(--text-xs); font-weight: 700; }
  select { width: 100%; min-height: 2.75rem; padding: var(--space-sm) var(--space-md); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); outline: var(--rule-medium) solid transparent; outline-offset: var(--space-3xs); background: var(--color-paper); color: var(--color-ink); font: inherit; }
  select:focus { outline-color: var(--color-focus); } select:disabled { cursor: not-allowed; opacity: .55; }
  .game-row__actions { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-sm); }
  .delete { color: var(--color-error); }
  .game-add { padding-block-start: var(--space-md); }
  .game-add summary { display: inline-flex; min-height: 2.75rem; align-items: center; gap: var(--space-xs); color: var(--color-accent); cursor: pointer; white-space: nowrap; }
  .game-add summary svg { width: 1em; height: 1em; }
  .game-add form { display: grid; gap: var(--space-md); margin-block-start: var(--space-lg); padding-block: var(--space-lg); border-block: var(--rule-hair) solid var(--color-rule); }
  .game-add > p { margin-block-start: var(--space-sm); color: var(--color-muted); }
  @media (hover: hover) and (pointer: fine) { button:hover { border-color: var(--color-ink); background: var(--color-paper-2); } .primary:hover, .game-add button:hover { border-color: var(--color-ink); background: var(--color-ink); } select:hover { background: var(--color-paper-2); } }
  button:active { background: var(--color-paper-3); } .primary:active, .game-add button:active { background: var(--color-ink); }
  @media (min-width: 40rem) { .post-index li { grid-template-columns: 10rem minmax(0, 1fr) auto; align-items: center; column-gap: var(--space-lg); } .post-index__meta { display: grid; } .game-add form { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: end; } }
  @media (min-width: 60rem) { .dashboard__head { grid-template-columns: auto minmax(0, 1fr) auto; align-items: end; } .dashboard__identity { padding-inline-start: var(--space-lg); } .game-row { grid-template-columns: minmax(12rem, 1.35fr) repeat(4, minmax(8rem, 1fr)) auto; align-items: end; } .game-row__actions { flex-wrap: nowrap; } .game-add form { grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr)) auto; } }
</style>
