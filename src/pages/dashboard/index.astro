---
import {
	Edit3,
	Gamepad2,
	LogOut,
	Plus,
	Save,
	Trash2,
	User,
	UserPen,
} from "lucide-astro";
import Layout from "../../layouts/Layout.astro";
import { cmsClient, getMediaUrl } from "../../lib/cms";
import type {
	CmsGame,
	CmsGameEntry,
	CmsPost,
	CmsSeries,
} from "../../lib/cms-types";
import {
	DashboardError,
	getDashboardToken,
	isSameOriginRequest,
	listOwnGameEntries,
	listOwnPosts,
	listOwnSeries,
	mutateGameEntry,
} from "../../lib/dashboard.server";

export const prerender = false;
const user = Astro.locals.user;
if (!user) return Astro.redirect("/auth/login?next=/dashboard", 302);

if (Astro.request.method === "POST") {
	if (!isSameOriginRequest(Astro.request, Astro.site))
		return new Response("Forbidden", { status: 403 });
	try {
		const token = getDashboardToken(Astro.cookies);
		const input = await Astro.request.formData();
		const resultKey = await mutateGameEntry(token, user.id, input);
		// astro check はテンプレートリテラル内の参照を追えず未使用と誤検知する
		void resultKey;
		return new Response(null, {
			status: 303,
			headers: { Location: `/dashboard?notice=${resultKey}#games` },
		});
	} catch (cause) {
		const failure =
			cause instanceof DashboardError
				? cause.message
				: "設定を保存できませんでした。";
		void failure;
		return new Response(null, {
			status: 303,
			headers: {
				Location: `/dashboard?error=${encodeURIComponent(failure)}#games`,
			},
		});
	}
}

let posts: CmsPost[] = [],
	entries: CmsGameEntry[] = [],
	games: CmsGame[] = [],
	ownSeries: CmsSeries[] = [];
let loadError = "";
try {
	const token = getDashboardToken(Astro.cookies);
	[posts, entries, games, ownSeries] = await Promise.all([
		listOwnPosts(token, user.id),
		listOwnGameEntries(token, user.id),
		cmsClient.items<CmsGame>("games").readByQuery({ sort: "name", limit: 500 }),
		listOwnSeries(token, user.id),
	]);
} catch (cause) {
	console.error("[Dashboard] Error loading dashboard", cause);
	loadError =
		"管理データを読み込めませんでした。PocketBase のマイグレーション適用状況を確認してください。";
}

const avatar = getMediaUrl(user.avatar);
const displayName = user.name || user.username || "メンバー";
const registeredGames = new Set(entries.map((entry) => entry.game.id));
const availableGames = games.filter((game) => !registeredGames.has(game.id));

const publishedCount = posts.filter(
	(post) => post.status === "published",
).length;
const draftCount = posts.length - publishedCount;
const stats = [
	{ label: "公開", value: publishedCount },
	{ label: "下書き", value: draftCount },
	{ label: "ゲーム", value: entries.length },
	{ label: "シリーズ", value: ownSeries.length },
];

const notices: Record<string, string> = {
	"post-deleted": "記事を削除しました。",
	"game-added": "ゲームを追加しました。",
	"game-saved": "ゲーム情報を保存しました。",
	"game-deleted": "ゲームを削除しました。",
	"series-deleted": "シリーズを削除しました。",
};
const notice = notices[Astro.url.searchParams.get("notice") ?? ""];
const error = Astro.url.searchParams.get("error") || loadError;

const skillOptions = [
	["", "未設定"],
	["casual", "気軽に"],
	["intermediate", "慣れている"],
	["expert", "熟練"],
	["better_than_you", "かなり得意"],
] as const;
const impressionOptions = [
	["", "未設定"],
	["obsessed", "夢中"],
	["love", "大好き"],
	["like", "好き"],
	["meh", "普通"],
	["give_up", "断念"],
] as const;
const recruitmentOptions = [
	["", "募集なし"],
	["looking_for_group", "一緒に遊ぶ人を募集中"],
	["invite_anytime", "いつでも誘って"],
	["need_hints", "ヒントがほしい"],
	["can_teach", "教えられます"],
	["discussion_welcome", "話したい"],
] as const;

const labelOf = (
	options: readonly (readonly [string, string])[],
	value?: string,
) => options.find(([option]) => option === (value ?? ""))?.[1] ?? "";

/** カードの下に出す一言。設定済みのものだけ拾う */
function summarize(entry: CmsGameEntry): string {
	return [
		labelOf(skillOptions, entry.skill_level),
		labelOf(recruitmentOptions, entry.recruitment),
	]
		.filter((text) => text && text !== "未設定" && text !== "募集なし")
		.join(" · ");
}

const date = new Intl.DateTimeFormat("ja-JP", {
	year: "numeric",
	month: "short",
	day: "numeric",
});
---

<Layout title="ダッシュボード" noindex={true}>
  <main class="dashboard container">
    <header class="dashboard__head">
      <div class="dashboard__head-top">
        <div class="dashboard__identity">
          {avatar
            ? <img src={avatar} alt="" width="80" height="80" />
            : <span class="dashboard__avatar"><User aria-hidden="true" /></span>}
          <div>
            <p class="dashboard__eyebrow">Dashboard</p>
            <h1>{displayName}</h1>
            <div class="dashboard__role">
              <span>{user.staff_title || (user.is_staff ? "運営メンバー" : "メンバー")}</span>
            </div>
          </div>
        </div>

        <nav class="dashboard__actions" aria-label="アカウント操作">
          <a class="button button--primary" href="/dashboard/profile"><UserPen aria-hidden="true" />プロフィールを編集</a>
          <a class="button" href={`/users/${user.id}`}>公開プロフィール</a>
          <form method="POST" action="/auth/logout" data-astro-reload>
            <button class="button button--danger" type="submit"><LogOut aria-hidden="true" />ログアウト</button>
          </form>
        </nav>
      </div>

      <dl class="dashboard__stats">
        {stats.map((stat) => (
          <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>
        ))}
      </dl>
    </header>

    {(notice || error) && (
      <p class:list={["dashboard__message", { "dashboard__message--error": error }]} role={error ? "alert" : "status"}>
        {error || notice}
      </p>
    )}

    <section class="section" aria-labelledby="posts-heading">
      <header class="section__head">
        <div class="section__title">
          <h2 id="posts-heading">記事</h2>
          {posts.length > 0 && (
            <div class="tabs" role="tablist" aria-label="記事の絞り込み">
              <button type="button" role="tab" aria-selected="true" data-filter="all">すべて {posts.length}</button>
              <button type="button" role="tab" aria-selected="false" data-filter="published">公開 {publishedCount}</button>
              <button type="button" role="tab" aria-selected="false" data-filter="draft">下書き {draftCount}</button>
            </div>
          )}
        </div>
        <div class="section__tools">
          <a class="button button--primary" href="/dashboard/posts/new"><Plus aria-hidden="true" />新しい記事</a>
        </div>
      </header>

      {posts.length ? (
        <ol class="posts" data-posts>
          {posts.map((post) => (
            <li data-status={post.status}>
              <div class="posts__meta">
                <span class="posts__badge-row">
                  <span class:list={["status", { "status--live": post.status === "published" }]}>
                    {post.status === "published" ? "公開" : "下書き"}
                  </span>
                  <time datetime={post.updatedAt}>{date.format(new Date(post.updatedAt))} 更新</time>
                </span>
              </div>
              <div class="posts__body">
                <h3>
                  <a href={post.status === "published" ? `/posts/${post.slug || post.id}` : `/dashboard/posts/${post.id}`}>
                    {post.title}
                  </a>
                </h3>
                <a class="posts__edit" href={`/dashboard/posts/${post.id}`}><Edit3 aria-hidden="true" />編集</a>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty">
          <h3>まだ記事はありません</h3>
          <p>下書きは自分にだけ見えます。書きかけのまま置いておいて大丈夫です。</p>
          <div class="empty__actions">
            <a class="button button--primary" href="/dashboard/posts/new"><Plus aria-hidden="true" />最初の記事を書く</a>
            <a class="link" href="/posts">公開されている記事を見る</a>
          </div>
        </div>
      )}
    </section>

    <section class="section" id="series" aria-labelledby="series-heading">
      <header class="section__head">
        <div class="section__title"><h2 id="series-heading">シリーズ</h2></div>
        <div class="section__tools">
          <a class="button button--primary" href="/dashboard/series/new"><Plus aria-hidden="true" />新しいシリーズ</a>
        </div>
      </header>

      {ownSeries.length ? (
        <ol class="posts">
          {ownSeries.map((item) => (
            <li>
              <div class="posts__meta">
                <span class="posts__badge-row">
                  <span class:list={["status", { "status--live": item.status === "published" }]}>
                    {item.status === "published" ? "公開" : "下書き"}
                  </span>
                  {item.owner !== user.id && <span>共同編集</span>}
                  <time datetime={item.updatedAt}>{date.format(new Date(item.updatedAt))} 更新</time>
                </span>
              </div>
              <div class="posts__body">
                <h3>
                  <a href={item.status === "published" ? `/series/${item.slug || item.id}` : `/dashboard/series/${item.id}`}>
                    {item.title}
                  </a>
                </h3>
                <a class="posts__edit" href={`/dashboard/series/${item.id}`}><Edit3 aria-hidden="true" />編集</a>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty">
          <h3>まだシリーズはありません</h3>
          <p>続きものを書くときにまとめられます。ほかのメンバーと一緒に編集することもできます。</p>
          <div class="empty__actions">
            <a class="button button--primary" href="/dashboard/series/new"><Plus aria-hidden="true" />シリーズを作る</a>
          </div>
        </div>
      )}
    </section>

    <section class="section section--shelf" id="games" aria-labelledby="games-heading">
      <div class="shelf">
        <header class="section__head">
          <div class="section__title"><h2 id="games-heading">ゲーム棚</h2></div>
          <div class="section__tools"><span class="count">{entries.length} タイトル</span></div>
        </header>

        <div class="shelf__grid">
          {entries.map((entry) => {
            const cover = entry.game.cover_image?.url;
            const summary = summarize(entry);
            return (
              <article class="game-card">
                <button type="button" data-select-game={entry.id} aria-controls="game-panel">
                  <span class="game-card__cover">
                    {cover
                      ? <img src={cover} alt="" width="120" height="160" loading="lazy" />
                      : <Gamepad2 aria-hidden="true" />}
                    <span class:list={["game-card__chip", { "game-card__chip--finished": entry.list === "finished" }]}>
                      {entry.list === "finished" ? "終了" : "プレイ中"}
                    </span>
                  </span>
                  <span class="game-card__name">{entry.game.name}</span>
                  {summary && <span class="game-card__summary">{summary}</span>}
                </button>
              </article>
            );
          })}

          <button class="game-add" type="button" data-select-game="new" aria-controls="game-panel">
            <Plus aria-hidden="true" />
            <span>追加</span>
          </button>
        </div>
      </div>

      <aside class="panel" id="game-panel" aria-label="ゲームの設定">
        {entries.map((entry) => (
          <form class="panel__form" method="POST" action="/dashboard" data-astro-reload data-game-form={entry.id} hidden>
            <input type="hidden" name="id" value={entry.id} />
            <header class="panel__head">
              <span class="panel__thumb">
                {entry.game.cover_image?.url
                  ? <img src={entry.game.cover_image.url} alt="" width="36" height="48" loading="lazy" />
                  : <Gamepad2 aria-hidden="true" />}
              </span>
              <div>
                <h3>{entry.game.name}</h3>
                <p>{date.format(new Date(entry.game.updatedAt))} 更新</p>
              </div>
            </header>

            <div class="panel__body">
              <label class="field"><span class="field__label">状態</span>
                <select name="list">
                  <option value="playing" selected={entry.list === "playing"}>プレイ中</option>
                  <option value="finished" selected={entry.list === "finished"}>プレイ終了</option>
                </select>
              </label>
              <label class="field"><span class="field__label">遊び方</span>
                <select name="skill_level">{skillOptions.map(([value, label]) => <option value={value} selected={entry.skill_level === value}>{label}</option>)}</select>
              </label>
              <label class="field"><span class="field__label">感想</span>
                <select name="impression">{impressionOptions.map(([value, label]) => <option value={value} selected={entry.impression === value}>{label}</option>)}</select>
              </label>
              <label class="field"><span class="field__label">募集</span>
                <select name="recruitment">{recruitmentOptions.map(([value, label]) => <option value={value} selected={entry.recruitment === value}>{label}</option>)}</select>
              </label>

              <button class="button button--primary" type="submit" name="_action" value="update"><Save aria-hidden="true" />保存する</button>

              <div class="panel__foot">
                <button class="button button--danger" type="submit" name="_action" value="delete"><Trash2 aria-hidden="true" />棚から外す</button>
              </div>
            </div>
          </form>
        ))}

        <form class="panel__form" method="POST" action="/dashboard" data-astro-reload data-game-form="new" hidden>
          <header class="panel__head">
            <span class="panel__thumb"><Plus aria-hidden="true" /></span>
            <div><h3>ゲームを追加</h3><p>棚に並べるタイトルを選びます</p></div>
          </header>
          <div class="panel__body">
            {availableGames.length === 0 && (
              <p class="panel__note">棚に入れられるゲームがありません。マスタに登録されたタイトルがすべて棚にある状態です。</p>
            )}
            <label class="field"><span class="field__label">ゲーム</span>
              <select name="game" required disabled={availableGames.length === 0}>
                <option value="">選択してください</option>
                {availableGames.map((game) => <option value={game.id}>{game.name}</option>)}
              </select>
            </label>
            <label class="field"><span class="field__label">状態</span>
              <select name="list"><option value="playing">プレイ中</option><option value="finished">プレイ終了</option></select>
            </label>
            <label class="field"><span class="field__label">遊び方</span>
              <select name="skill_level">{skillOptions.map(([value, label]) => <option value={value}>{label}</option>)}</select>
            </label>
            <label class="field"><span class="field__label">感想</span>
              <select name="impression">{impressionOptions.map(([value, label]) => <option value={value}>{label}</option>)}</select>
            </label>
            <label class="field"><span class="field__label">募集</span>
              <select name="recruitment">{recruitmentOptions.map(([value, label]) => <option value={value}>{label}</option>)}</select>
            </label>
            <button class="button button--primary" type="submit" disabled={availableGames.length === 0}><Plus aria-hidden="true" />棚に追加する</button>
          </div>
        </form>

        <p class="panel__placeholder" data-game-placeholder>
          {entries.length ? "棚のタイトルを選ぶと、ここで設定を変えられます。" : "まだ棚は空です。「追加」から始められます。"}
        </p>
      </aside>
    </section>
  </main>
</Layout>

<script>
  import { onEachPage } from "../../scripts/on-page";

  onEachPage(() => {
    // --- 記事の絞り込み ---
    const list = document.querySelector<HTMLElement>("[data-posts]");
    const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    if (list && tabs.length && list.dataset.bound !== "true") {
      list.dataset.bound = "true";
      for (const tab of tabs) {
        tab.addEventListener("click", () => {
          const filter = tab.dataset.filter ?? "all";
          for (const other of tabs)
            other.setAttribute("aria-selected", String(other === tab));
          for (const item of list.querySelectorAll<HTMLElement>("li")) {
            item.hidden = filter !== "all" && item.dataset.status !== filter;
          }
        });
      }
    }

    // --- ゲーム棚：カードを選ぶと右のパネルにその設定を出す ---
    const panel = document.querySelector<HTMLElement>("#game-panel");
    const cards = [...document.querySelectorAll<HTMLButtonElement>("[data-select-game]")];
    if (!panel || !cards.length || panel.dataset.bound === "true") return;
    panel.dataset.bound = "true";

    const forms = [...panel.querySelectorAll<HTMLFormElement>("[data-game-form]")];
    const placeholder = panel.querySelector<HTMLElement>("[data-game-placeholder]");

    const show = (id: string) => {
      for (const form of forms) form.hidden = form.dataset.gameForm !== id;
      if (placeholder) placeholder.hidden = true;
      for (const card of cards) {
        card.setAttribute("aria-pressed", String(card.dataset.selectGame === id));
      }
    };

    for (const card of cards) {
      card.setAttribute("aria-pressed", "false");
      card.addEventListener("click", () => show(card.dataset.selectGame ?? ""));
    }

    // 開いた直後から設定を触れるよう、最初のタイトルを出しておく
    const first = forms.find((form) => form.dataset.gameForm !== "new");
    if (first?.dataset.gameForm) show(first.dataset.gameForm);
  });
</script>

<style>
  /* Hallmark · genre: editorial · macrostructure: Index-First · design-system: design.md
   * 上に本人と実績、下に「記事」と「ゲーム棚」。棚は一覧と設定パネルを左右に置く。
   */
  .dashboard { padding-block: var(--space-xl) var(--space-3xl); }

  /* --- 本人 --- */
  .dashboard__head { display: grid; gap: var(--space-md); padding-block-end: var(--space-lg); border-block-end: var(--rule-medium) solid var(--color-ink); }
  .dashboard__head-top { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-lg); }
  .dashboard__identity { display: flex; align-items: center; gap: var(--space-lg); }
  .dashboard__identity img, .dashboard__avatar { display: grid; width: 5rem; height: 5rem; flex: 0 0 5rem; place-items: center; overflow: hidden; border-radius: 50%; object-fit: cover; background: var(--color-paper-2); color: var(--color-muted); }
  .dashboard__avatar svg { width: 1.75rem; height: 1.75rem; }
  .dashboard__eyebrow { color: var(--color-accent); font-size: var(--text-sm); font-weight: 700; }
  .dashboard__identity h1 { font-size: var(--text-2xl); line-height: 1.1; letter-spacing: -.02em; overflow-wrap: anywhere; }
  .dashboard__role { display: flex; align-items: center; gap: var(--space-sm); color: var(--color-muted); font-size: var(--text-sm); }
  .dashboard__actions { display: flex; align-items: center; gap: var(--space-md); }
  .dashboard__stats { display: flex; flex-wrap: wrap; gap: var(--space-xl); font-size: var(--text-sm); }
  .dashboard__stats > div { display: flex; align-items: baseline; gap: var(--space-xs); }
  .dashboard__stats dt { color: var(--color-muted); }
  .dashboard__stats dd { font-family: var(--font-mono); font-size: var(--text-md); font-variant-numeric: tabular-nums; }

  .dashboard__message { margin-block-start: var(--space-lg); padding: var(--space-sm) var(--space-md); border: var(--rule-hair) solid var(--color-success); }
  .dashboard__message--error { border-color: var(--color-error); }

  /* --- ボタン --- */
  .button { display: inline-flex; min-height: 2.5rem; align-items: center; justify-content: center; gap: var(--space-xs); padding-inline: var(--space-md); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-ink); font: inherit; font-size: var(--text-sm); cursor: pointer; white-space: nowrap; }
  .button svg { width: 1em; height: 1em; }
  .button--primary { border-color: var(--color-accent); background: var(--color-accent); color: var(--color-accent-ink); }
  .button--bare { border: 0; background: transparent; color: var(--color-muted); }
  .button--danger { border-color: var(--color-error); background: var(--color-paper); color: var(--color-error); font-weight: 700; }
  .button:disabled { cursor: not-allowed; opacity: .55; }
  .link { display: inline-flex; min-height: 2.5rem; align-items: center; border-block-end: var(--rule-hair) solid var(--color-accent); color: var(--color-accent); }

  /* --- セクション --- */
  .section { padding-block: var(--space-xl); }
  .section__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-lg); padding-block-end: var(--space-md); border-block-end: var(--rule-hair) solid var(--color-rule-strong); }
  .section__title { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-lg); }
  .section__title h2 { font-size: var(--text-xl); line-height: 1.15; }
  .section__title > p { color: var(--color-muted); font-size: var(--text-sm); }
  .section__tools { display: flex; align-items: center; gap: var(--space-sm); }
  .count { color: var(--color-muted); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .tabs { display: flex; gap: var(--space-lg); font-size: var(--text-sm); }
  .tabs button { padding: 0 0 var(--space-2xs); border: 0; background: transparent; color: var(--color-ink-2); font: inherit; font-size: var(--text-sm); cursor: pointer; }
  .tabs button[aria-selected="true"] { box-shadow: inset 0 -2px 0 var(--color-accent); color: var(--color-ink); font-weight: 700; }

  /* --- 記事 --- */
  .posts { display: grid; list-style: none; }
  .posts li { display: grid; gap: var(--space-xs); padding-block: var(--space-md); border-block-end: var(--rule-hair) solid var(--color-rule); }
  /* display を明示しているので、hidden 属性を効かせるには打ち消しが要る */
  .posts li[hidden] { display: none; }
  .posts__meta { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); color: var(--color-muted); font-size: var(--text-xs); }
  .posts__badge-row { display: inline-flex; align-items: center; gap: var(--space-xs); }
  .status { padding: var(--space-3xs) var(--space-xs); border: var(--rule-hair) solid var(--color-rule-strong); color: var(--color-muted); }
  .status--live { border-color: var(--color-success); color: var(--color-success); }
  .posts__body { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); }
  .posts__body h3 { min-width: 0; font-size: var(--text-md); line-height: 1.35; overflow-wrap: anywhere; }
  .posts__body h3 a { color: inherit; }
  .posts__body a { display: inline-flex; align-items: center; gap: var(--space-xs); color: var(--color-accent); font-size: var(--text-sm); white-space: nowrap; }
