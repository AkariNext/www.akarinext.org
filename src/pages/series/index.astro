---
import { BookOpen, Layers } from "lucide-astro";
import Layout from "../../layouts/Layout.astro";
import {
	type CmsPost,
	type CmsSeries,
	cmsClient,
	getMediaUrl,
} from "../../lib/cms";

export const prerender = false;

let series: CmsSeries[] = [];
let posts: CmsPost[] = [];
try {
	[series, posts] = await Promise.all([
		cmsClient.items<CmsSeries>("series").readByQuery({ sort: ["-createdAt"] }),
		// 記事側から件数と最終更新を集計する。posts の取得上限は 200 件（pbFetchList の既定）。
		cmsClient
			.items<CmsPost>("posts")
			.readByQuery({ limit: 200, sort: ["-published_date", "-createdAt"] }),
	]);
} catch (error) {
	console.error("[Series] Error fetching data", error);
}

/** シリーズ ID ごとの記事数と最新公開日 */
const stats = new Map<string, { count: number; latest: string }>();
for (const post of posts) {
	const id = post.series?.id;
	if (!id) continue;
	const date = post.published_date || post.createdAt;
	const current = stats.get(id);
	if (current) {
		current.count += 1;
		if (date > current.latest) current.latest = date;
	} else {
		stats.set(id, { count: 1, latest: date });
	}
}

// 記事が 1 本もないシリーズは出さない（作りかけが公開面に漏れないように）
const listed = series
	.map((item) => ({
		series: item,
		...(stats.get(item.id) || { count: 0, latest: "" }),
	}))
	.filter((item) => item.count > 0)
	.sort((a, b) => b.latest.localeCompare(a.latest));

const formatDate = (value: string) =>
	new Date(value).toLocaleDateString("ja-JP", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
const totalPosts = listed.reduce((sum, item) => sum + item.count, 0);
---

<Layout
  title="シリーズ"
  description={`AkariNextのメンバーが続けて書いている連載を${listed.length}本まとめています。`}
  canonical="/series"
>
  <div class="series-index container">
    <header class="series-index__head">
      <p>AkariNext Journal</p>
      <h1>シリーズ</h1>
      <div class="series-index__summary">
        <p>ひとつのテーマを続けて書いた記事を、連載としてまとめています。順番に読むと流れが分かります。</p>
        {listed.length > 0 && <span>{listed.length} シリーズ / {totalPosts} 本</span>}
      </div>
    </header>

    {listed.length > 0 ? (
      <div class="series-list">
        {listed.map(({ series: item, count, latest }) => {
          const cover = getMediaUrl(item.cover_image);
          const href = `/series/${item.slug || item.id}`;
          return (
            <article class:list={["series-row", { "series-row--with-image": Boolean(cover) }]}>
              <div class="series-row__meta">
                <span class="series-row__count"><Layers aria-hidden="true" />全 {count} 本</span>
                <time datetime={latest}>{formatDate(latest)}</time>
              </div>
              <div class="series-row__body">
                <h2><a href={href}>{item.title}</a></h2>
                {item.description && <p>{item.description}</p>}
                <a href={href} class="series-row__link">シリーズを読む</a>
              </div>
              {cover && (
                <a href={href} class="series-row__image" aria-label={`${item.title}を読む`}>
                  <img src={cover} alt="" loading="lazy" decoding="async" />
                </a>
              )}
            </article>
          );
        })}
      </div>
    ) : (
      <div class="series-empty">
        <BookOpen aria-hidden="true" />
        <h2>公開中のシリーズはまだありません</h2>
        <p>連載が始まったらここに並びます。</p>
        <a href="/posts">すべての記事を見る</a>
      </div>
    )}
  </div>
</Layout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Index · design-system: design.md */
  .series-index { padding-block: var(--space-2xl) var(--space-4xl); }
  .series-index__head { display: grid; gap: var(--space-lg); padding-block-end: var(--space-2xl); border-block-end: var(--rule-medium) solid var(--color-ink); }
  .series-index__head > p { color: var(--color-accent); font-weight: 700; }
  .series-index__head h1 { max-width: 18ch; font-size: var(--text-display); line-height: 1.08; letter-spacing: -0.04em; }
  .series-index__summary { display: grid; gap: var(--space-md); align-items: end; }
  .series-index__summary p { max-width: 58ch; color: var(--color-ink-2); font-size: var(--text-md); line-height: 1.8; }
  .series-index__summary span { color: var(--color-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .series-row { display: grid; gap: var(--space-lg); padding-block: var(--space-xl); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .series-row:last-child { border-block-end: 0; }
  .series-row__meta { display: grid; align-content: start; justify-items: start; gap: var(--space-sm); color: var(--color-muted); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .series-row__count { display: inline-flex; align-items: center; gap: var(--space-xs); white-space: nowrap; }
  .series-row__count svg { width: 1em; height: 1em; }
  .series-row__body { display: grid; align-content: start; gap: var(--space-md); min-width: 0; }
  .series-row__body h2 { max-width: 24ch; font-size: var(--text-xl); line-height: 1.3; overflow-wrap: anywhere; }
  .series-row__body > p { max-width: 62ch; color: var(--color-ink-2); line-height: 1.8; }
  .series-row__link { justify-self: start; min-height: 2.75rem; padding-block: var(--space-sm); border-block-end: var(--rule-hair) solid var(--color-accent); color: var(--color-accent); white-space: nowrap; }
  .series-row__image { display: block; aspect-ratio: 4 / 3; min-width: 0; overflow: clip; background: var(--color-paper-2); }
  .series-row__image img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-long) var(--ease-out); }
  .series-empty { display: grid; justify-items: start; gap: var(--space-md); padding-block: var(--space-3xl); }
  .series-empty > svg { width: var(--space-xl); color: var(--color-muted); }
  .series-empty a { min-height: 2.75rem; padding-block: var(--space-sm); border-block-end: var(--rule-hair) solid var(--color-accent); color: var(--color-accent); }
  @media (hover: hover) and (pointer: fine) { .series-row__body h2 a:hover, .series-row__link:hover { color: var(--color-accent); } .series-row__image:hover img { transform: scale(1.02); } }
  @media (min-width: 40rem) { .series-row { grid-template-columns: 9rem minmax(0, 1fr); } .series-row--with-image { grid-template-columns: 9rem minmax(0, 1fr) minmax(12rem, 0.42fr); } .series-index__summary { grid-template-columns: minmax(0, 1fr) auto; } }
  @media (max-width: 39.99rem) { .series-index { padding-block-start: var(--space-xl); } .series-row__image { order: -1; } }
</style>
