---
import { Gamepad2, Search } from "lucide-astro";
import Layout from "../../layouts/Layout.astro";
import { cmsClient, getMediaUrl, type CmsGame, type CmsMember } from "../../lib/cms";

let games: CmsGame[] = [];

interface PlayerData {
  user: CmsMember;
  skill_level?: string;
  impression?: string;
  recruitment?: string;
}

const playersByGame = new Map<string, PlayerData[]>();

try {
  games = await cmsClient.items<CmsGame>("games").readByQuery({ limit: 100, sort: ["name"] });
  const authors = await cmsClient.items<CmsMember>("authors").readByQuery({ limit: 100 });

  authors.forEach((author) => {
    if (!Array.isArray(author.playing_games)) return;
    author.playing_games.forEach((playInfo) => {
      const game = playInfo.game;
      const gameId = game && typeof game === "object" ? game.id : undefined;
      if (!gameId) return;
      const players = playersByGame.get(gameId) || [];
      players.push({ user: author, skill_level: playInfo.skill_level || undefined, impression: playInfo.impression || undefined, recruitment: playInfo.recruitment || undefined });
      playersByGame.set(gameId, players);
    });
  });
} catch (error) {
  console.error("Error fetching games data:", error);
}

const skillLabel = (value?: string) => ({ casual: "カジュアル", intermediate: "中級", expert: "エキスパート", better_than_you: "あなたより上手" })[value || ""] || null;
const impressionLabel = (value?: string) => ({ obsessed: "夢中", love: "大好き", like: "わりと好き", meh: "ビミョーかも", give_up: "ギブアップ" })[value || ""] || null;
const recruitmentLabel = (value?: string) => ({ looking_for_group: "グループ探してます", invite_anytime: "いつでも誘って", need_hints: "ヒントを教えて", can_teach: "教えられるよ", discussion_welcome: "議論大歓迎" })[value || ""] || null;
const activeGames = games.filter((game) => (playersByGame.get(game.id) || []).length > 0);
const libraryGames = games.filter((game) => (playersByGame.get(game.id) || []).length === 0);
---

<Layout title="ゲーム" description="コミュニティーメンバーが遊んでいるゲームの一覧">
  <div class="games-index container">
    <header class="games-index__head">
      <p>AkariNext Library</p>
      <h1>ゲーム</h1>
      <div class="games-index__summary">
        <p>いま誰が、何を遊んでいるか。メンバーのゲームライブラリを一覧できます。</p>
        <span>{games.length} タイトル</span>
      </div>
    </header>

    <div class="game-search">
      <label for="gameSearch">タイトル・メンバーから探す</label>
      <div class="game-search__field">
        <Search aria-hidden="true" />
        <input id="gameSearch" type="search" placeholder="ゲーム名またはメンバー名" autocomplete="off" />
      </div>
    </div>

    {games.length > 0 ? (
      <div class="games-directory" id="gamesGrid">
        {activeGames.length > 0 && <section class="game-section game-section--active">
          <header class="game-section__head"><h2>プレイ中</h2><span>{activeGames.length} タイトル</span></header>
          <div class="active-games">{activeGames.map((game) => {
            const players = playersByGame.get(game.id) || [];
            const cover = getMediaUrl(game.cover_image);
            const searchablePlayers = players.map(({ user }) => user.name || user.username).join(" ").toLowerCase();
            return <article class="game-entry active-game" data-name={game.name.toLowerCase()} data-players={searchablePlayers}>
              <div class="game-entry__cover">{cover ? <img src={cover} alt="" loading="lazy" decoding="async" /> : <div class="game-entry__placeholder"><Gamepad2 aria-hidden="true" /><span>NO COVER</span></div>}</div>
              <div class="active-game__content">
                <h3>{game.name}</h3>
                <ul class="active-player-list" aria-label={`${game.name}を遊んでいるメンバー`}>{players.map((player) => {
                  const member = player.user;
                  const name = member.name || member.username;
                  const avatar = getMediaUrl(member.avatar);
                  const details = [skillLabel(player.skill_level), impressionLabel(player.impression), recruitmentLabel(player.recruitment)].filter(Boolean);
                  return <li><a href={`/users/${member.id}`}><span class="player-list__avatar">{avatar ? <img src={avatar} alt="" loading="lazy" decoding="async" /> : <span>{name.charAt(0)}</span>}</span><span class="active-player__text"><strong>{name}</strong>{details.length > 0 && <small>{details.join(" ・ ")}</small>}</span></a></li>;
                })}</ul>
              </div>
            </article>;
          })}</div>
        </section>}
        {libraryGames.length > 0 && <section class="game-section game-section--library">
          <header class="game-section__head"><h2>登録ゲーム</h2><span>{libraryGames.length} タイトル</span></header>
          <div class="game-catalogue">{libraryGames.map((game) => {
            const cover = getMediaUrl(game.cover_image);
            return <article class="game-entry library-game" data-name={game.name.toLowerCase()} data-players="">
              <div class="game-entry__cover">{cover ? <img src={cover} alt="" loading="lazy" decoding="async" /> : <div class="game-entry__placeholder"><Gamepad2 aria-hidden="true" /><span>NO COVER</span></div>}</div>
              <h3>{game.name}</h3>
            </article>;
          })}</div>
        </section>}
      </div>
    ) : <div class="games-empty"><Gamepad2 aria-hidden="true" /><h2>ゲームはまだ登録されていません</h2></div>}
    <p class="search-empty" id="searchEmpty" hidden>条件に合うゲームが見つかりませんでした。</p>
  </div>
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>("#gameSearch");
  const entries = Array.from(document.querySelectorAll<HTMLElement>(".game-entry"));
  const sections = Array.from(document.querySelectorAll<HTMLElement>(".game-section"));
  const empty = document.querySelector<HTMLElement>("#searchEmpty");
  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    entries.forEach((entry) => {
      const matches = `${entry.dataset.name || ""} ${entry.dataset.players || ""}`.includes(query);
      entry.hidden = !matches;
      if (matches) visible += 1;
    });
    sections.forEach((section) => { section.hidden = !section.querySelector(".game-entry:not([hidden])"); });
    if (empty) empty.hidden = visible !== 0;
  });
</script>

<style is:global>
  /* Hallmark · genre: editorial · macrostructure: Catalogue · design-system: design.md · designed-as-app */
  .games-index { padding-block: var(--space-2xl) var(--space-4xl); }
  .games-index__head { display: grid; gap: var(--space-lg); padding-block-end: var(--space-2xl); border-block-end: var(--rule-medium) solid var(--color-ink); }
  .games-index__head > p { color: var(--color-accent); font-weight: 700; }
  .games-index__head h1 { font-size: var(--text-display); line-height: 1; letter-spacing: -0.04em; }
  .games-index__summary { display: grid; gap: var(--space-md); align-items: end; }
  .games-index__summary p { max-width: 58ch; color: var(--color-ink-2); font-size: var(--text-md); line-height: 1.8; }
  .games-index__summary span { color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .game-search { display: grid; gap: var(--space-sm); padding-block: var(--space-xl); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .game-search label { color: var(--color-muted); font-size: var(--text-sm); font-weight: 700; }
  .game-search__field { position: relative; max-width: 34rem; }
  .game-search__field svg { position: absolute; inset-inline-start: var(--space-md); inset-block-start: 50%; width: 1.1rem; height: 1.1rem; color: var(--color-muted); transform: translateY(-50%); pointer-events: none; }
  .game-search input { width: 100%; min-height: 3rem; padding: var(--space-sm) var(--space-md) var(--space-sm) var(--space-xl); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-ink); font: inherit; transition: background-color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out); }
  .game-search input::placeholder { color: var(--color-muted); }
  .game-search input:focus { border-color: var(--color-focus); background: var(--color-paper-2); }
  .games-directory { display: grid; gap: var(--space-2xl); padding-block-start: var(--space-xl); }
  .game-section { display: grid; gap: var(--space-lg); }
  .game-section[hidden] { display: none; }
  .game-section__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-md); padding-block-end: var(--space-sm); border-block-end: var(--rule-hair) solid var(--color-rule-strong); }
  .game-section__head h2 { font-size: var(--text-lg); }
  .game-section__head span { color: var(--color-muted); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .active-games { display: grid; }
  .game-entry { min-width: 0; }
  .game-entry[hidden] { display: none; }
  .game-entry__cover { width: 100%; aspect-ratio: 3 / 4; min-width: 0; overflow: hidden; background: var(--color-paper-2); }
  .game-entry__cover img { display: block; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: center; }
  .game-entry__placeholder { display: grid; width: 100%; aspect-ratio: 3 / 4; place-items: center; align-content: center; gap: var(--space-sm); color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.08em; }
  .game-entry__placeholder svg { width: var(--space-xl); height: var(--space-xl); }
  .active-game { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: var(--space-lg); padding-block: var(--space-lg); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .active-game:first-child { padding-block-start: 0; }
  .active-game:last-child { padding-block-end: 0; border-block-end: 0; }
  .active-game__content { display: grid; align-content: start; gap: var(--space-lg); }
  .active-game__content h3 { font-size: var(--text-lg); line-height: 1.35; overflow-wrap: anywhere; }
  .active-player-list { display: flex; flex-wrap: wrap; gap: var(--space-md) var(--space-lg); list-style: none; }
  .active-player-list li { min-width: 0; }
  .active-player-list a { display: inline-flex; align-items: center; gap: var(--space-sm); min-width: 0; }
  .active-player__text { display: grid; gap: var(--space-2xs); }
  .active-player__text strong { font-size: var(--text-sm); }
  .active-player__text small { color: var(--color-muted); font-size: var(--text-xs); }
  .player-list__avatar { display: grid; flex: 0 0 1.75rem; width: 1.75rem; height: 1.75rem; place-items: center; overflow: clip; border: var(--rule-hair) solid var(--color-rule); border-radius: 50%; background: var(--color-paper-2); color: var(--color-muted); }
  .player-list__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .games-index .game-catalogue { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xl) var(--space-md); width: 100%; }
  .library-game { display: grid; align-content: start; gap: var(--space-sm); }
  .library-game h3 { font-size: var(--text-base); line-height: 1.45; overflow-wrap: break-word; }
  .search-empty { color: var(--color-muted); font-size: var(--text-sm); }
  .search-empty { padding-block: var(--space-2xl); }
  .games-empty { display: grid; justify-items: start; gap: var(--space-md); padding-block: var(--space-3xl); }
  .games-empty svg { width: var(--space-xl); color: var(--color-muted); }
  @media (hover: hover) and (pointer: fine) { .game-search input:hover { background: var(--color-paper-2); } .active-player-list a:hover strong { color: var(--color-accent); } }
  @media (min-width: 40rem) { .games-index__summary { grid-template-columns: minmax(0, 1fr) auto; } .games-index .game-catalogue { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-lg); } .active-game { grid-template-columns: 9rem minmax(0, 1fr); } }
  @media (min-width: 64rem) { .active-games { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-2xl); } .games-index .game-catalogue { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--space-xl); } }
  @media (max-width: 39.99rem) { .games-index { padding-block-start: var(--space-xl); } .active-game { grid-template-columns: 6rem minmax(0, 1fr); gap: var(--space-md); } .active-game__content { gap: var(--space-md); } .active-game__content h3 { font-size: var(--text-md); } .player-list__avatar { flex-basis: 1.4rem; width: 1.4rem; height: 1.4rem; } }
  @media (max-width: 22rem) { .games-index .game-catalogue { grid-template-columns: minmax(0, 1fr); } }
</style>
