---
import {
	ArrowRight,
	Gamepad2,
	Github,
	Globe,
	MessageSquare,
	Twitch,
	Twitter,
	Youtube,
} from "lucide-astro";
import Layout from "../../layouts/Layout.astro";
import {
	cmsClient,
	getMediaUrl,
	type CmsGame,
	type CmsMember,
	type CmsPost,
} from "../../lib/cms";
import {
	safeSocialUrl,
	socialDisplayId,
	socialPlatformOf,
} from "../../lib/social-links";

const { id } = Astro.params;
if (!id) return Astro.redirect("/404");

interface GamePlayer {
	game: CmsGame;
	status: "playing" | "finished";
	skill_level?: string;
	impression?: string;
	recruitment?: string;
}

let user: CmsMember | null = null;
let games: GamePlayer[] = [];
let posts: CmsPost[] = [];

try {
	const users = await cmsClient
		.items<CmsMember>("authors")
		.readByQuery({ where: { id: { equals: id } }, limit: 1 });
	user = users[0] || null;

	if (user) {
		const appendGames = (
			entries: CmsMember["playing_games"] | CmsMember["finished_games"],
			status: GamePlayer["status"],
		) => {
			if (!Array.isArray(entries)) return;
			entries.forEach((entry) => {
				if (entry.game && typeof entry.game === "object")
					games.push({
						game: entry.game,
						status,
						skill_level: entry.skill_level,
						impression: entry.impression,
						recruitment: entry.recruitment,
					});
			});
		};
		// 非公開にしている人のゲーム棚は集めない
		if (user.games_public) {
			appendGames(user.playing_games, "playing");
			appendGames(user.finished_games, "finished");
		}

		const allPosts = await cmsClient
			.items<CmsPost>("posts")
			.readByQuery({ sort: ["-published_date", "-createdAt"], limit: 100 });
		posts = allPosts.filter(
			(post) =>
				post.author && typeof post.author === "object" && post.author.id === id,
		);
	}
} catch (error) {
	console.error("Error fetching user profile:", error);
}

if (!user) return Astro.redirect("/404");

const name = user.name || user.username;
const avatar = getMediaUrl(user.avatar);
const postUrl = (post: CmsPost) => `/posts/${post.slug || post.id}`;
const postDate = (post: CmsPost) =>
	new Date(post.published_date || post.createdAt).toLocaleDateString("ja-JP", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
const excerpt = (post: CmsPost) =>
	post.is_spoiler
		? "この記事にはネタバレが含まれています。"
		: post.content
				?.replace(/[#*_`>[\]!|]/g, " ")
				.replace(/\s+/g, " ")
				.trim()
				.slice(0, 120) || "本文を読む";

const socialIcon = (platform?: string) => {
	switch (platform?.toLowerCase()) {
		case "twitter":
		case "x":
		case "x (twitter)":
			return Twitter;
		case "github":
			return Github;
		case "twitch":
			return Twitch;
		case "youtube":
			return Youtube;
		case "discord":
			return MessageSquare;
		case "steam":
			return Gamepad2;
		default:
			return Globe;
	}
};

const skillLabel = (value?: string) =>
	({
		casual: "カジュアル",
		intermediate: "中級",
		expert: "エキスパート",
		better_than_you: "あなたより上手",
	})[value || ""] || null;
const impressionLabel = (value?: string) =>
	({
		obsessed: "夢中",
		love: "大好き",
		like: "わりと好き",
		meh: "ビミョーかも",
		give_up: "ギブアップ",
	})[value || ""] || null;
const recruitmentLabel = (value?: string) =>
	({
		looking_for_group: "グループ募集中",
		invite_anytime: "いつでも誘って",
		need_hints: "ヒント歓迎",
		can_teach: "教えられます",
		discussion_welcome: "議論歓迎",
	})[value || ""] || null;
---

<Layout title={name} description={`${name}のプロフィール、記事、ゲームコレクション`}>
  <div class="member-page container">
    <header class="member-hero">
      <div class="member-avatar">
        {avatar ? <img src={avatar} alt={name} /> : <span>{name.charAt(0).toUpperCase()}</span>}
      </div>
      <div class="member-identity">
        <p>AkariNext Member{user.is_staff && <span class="member-role"> · 運営メンバー</span>}{user.location_public && user.location && <span class="member-role"> · {user.location}</span>}</p>
        <div class="member-title">
          <h1>{name}</h1>
        </div>
        {user.bio && <p class="member-bio">{user.bio}</p>}
        {user.social_links && user.social_links.length > 0 && <nav class="member-socials" aria-label={`${name}の外部リンク`}>
          {user.social_links.map((link) => {
            const Icon = socialIcon(link.platform);
            const platform = socialPlatformOf(link.platform);
            const service = platform === "x" ? "X" : platform === "github" ? "GitHub" : platform === "discord" ? "Discord" : platform === "steam" ? "Steam" : link.platform;
            const id = socialDisplayId(link);
            const href = safeSocialUrl(link);
            return href && <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${service}${id ? ` ${id}` : ""}`}><Icon aria-hidden="true" /><span><strong>{service}</strong>{id && <small>{id}</small>}</span></a>;
          })}
        </nav>}
      </div>
      <dl class="member-counts">
        <div><dt>記事</dt><dd>{posts.length}</dd></div>
        <div><dt>ゲーム</dt><dd>{games.length}</dd></div>
      </dl>
    </header>

    <div class="member-content">
      <section class="member-posts">
        <header class="section-head">
          <div><p>Writing</p><h2>執筆した記事</h2></div>
          {posts.length > 0 && <a href="/posts">記事一覧 <ArrowRight aria-hidden="true" /></a>}
        </header>
        {posts.length > 0 ? <div class="member-post-list">
          {posts.map((post) => <article class="member-post">
            <time datetime={post.published_date || post.createdAt}>{postDate(post)}</time>
            <div>
              <h3><a href={postUrl(post)}>{post.title}</a></h3>
              <p>{excerpt(post)}</p>
            </div>
            <a class="member-post__read" href={postUrl(post)} aria-label={`${post.title}を読む`}>読む <ArrowRight aria-hidden="true" /></a>
          </article>)}
        </div> : <p class="section-empty">執筆した記事はまだありません。</p>}
      </section>

      <aside class="member-games">
        <header class="section-head">
          <div><p>Games</p><h2>ゲーム</h2></div>
          <span>{games.length} タイトル</span>
        </header>
        {!user.games_public ? <p class="section-empty">ゲーム棚は非公開です。</p> : games.length > 0 ? <div class="member-game-grid">
          {games.map((entry) => {
            const cover = getMediaUrl(entry.game.cover_image);
            const details = [skillLabel(entry.skill_level), impressionLabel(entry.impression), recruitmentLabel(entry.recruitment)].filter(Boolean);
            return <article class="member-game">
              <div class="member-game__cover">{cover ? <img src={cover} alt="" loading="lazy" decoding="async" /> : <div><Gamepad2 aria-hidden="true" /></div>}</div>
              <div class="member-game__caption">
                <h3>{entry.game.name}</h3>
                <p>{entry.status === "playing" ? "プレイ中" : "プレイ終了"}</p>
                {details.length > 0 && <small>{details.join(" ・ ")}</small>}
              </div>
            </article>;
          })}
        </div> : <p class="section-empty">登録されているゲームはまだありません。</p>}
      </aside>
    </div>
  </div>
</Layout>

<style is:global>
  /* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 · genre: editorial · macrostructure: Member dossier · design-system: design.md */
  .member-page { padding-block: var(--space-2xl) var(--space-4xl); }
  .member-hero { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: var(--space-xl); align-items: start; padding-block-end: var(--space-2xl); border-block-end: var(--rule-medium) solid var(--color-ink); }
  .member-avatar { display: grid; width: 8rem; aspect-ratio: 1; place-items: center; overflow: hidden; background: var(--color-paper-2); color: var(--color-muted); font-family: var(--font-display); font-size: var(--text-2xl); }
  .member-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .member-identity { display: grid; align-content: start; gap: var(--space-md); min-width: 0; }
  .member-identity > p:first-child, .section-head > div > p { color: var(--color-accent); font-size: var(--text-sm); font-weight: 700; }
  .member-role { color: var(--color-muted); font-weight: 500; }
  .member-title { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm) var(--space-md); }
  .member-title h1 { min-width: 0; font-size: clamp(2.4rem, 7vw, 4.75rem); line-height: 1; letter-spacing: -0.04em; overflow-wrap: anywhere; }
  .member-bio { max-width: 52ch; color: var(--color-ink-2); font-size: var(--text-md); line-height: 1.8; }
  .member-socials { display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-lg); }
  .member-socials a { display: inline-flex; align-items: center; gap: var(--space-xs); padding-block-end: var(--space-3xs); color: var(--color-muted); font-size: var(--text-sm); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .member-socials svg { width: 1rem; height: 1rem; }
  .member-socials a > span { display: inline-flex; align-items: baseline; gap: var(--space-xs); }
  .member-socials strong { color: var(--color-ink-2); font-weight: 600; }
  .member-socials small { color: var(--color-muted); font-size: var(--text-xs); }
  .member-counts { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-block-start: var(--rule-hair) solid var(--color-rule); }
  .member-counts div { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-md); padding: var(--space-md) var(--space-lg) 0; }
  .member-counts div + div { padding-inline-start: var(--space-lg); border-inline-start: var(--rule-hair) solid var(--color-rule); }
  .member-counts dt { color: var(--color-muted); font-size: var(--text-sm); }
  .member-counts dd { font-family: var(--font-display); font-size: var(--text-lg); font-variant-numeric: tabular-nums; }
  .member-content { display: grid; gap: var(--space-3xl); padding-block-start: var(--space-2xl); }
  .member-posts, .member-games { min-width: 0; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: var(--space-md); padding-block-end: var(--space-md); border-block-end: var(--rule-hair) solid var(--color-rule-strong); }
  .section-head > div { display: grid; gap: var(--space-xs); }
  .section-head h2 { font-size: var(--text-xl); line-height: 1.25; }
  .section-head > a { display: inline-flex; align-items: center; gap: var(--space-xs); color: var(--color-accent); font-size: var(--text-sm); white-space: nowrap; }
  .section-head > a svg { width: 1em; height: 1em; }
  .section-head > span { color: var(--color-muted); font-size: var(--text-sm); white-space: nowrap; }
  .member-post { display: grid; gap: var(--space-md); padding-block: var(--space-xl); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .member-post:last-child { border-block-end: 0; }
  .member-post time { color: var(--color-muted); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .member-post > div { display: grid; align-content: start; gap: var(--space-sm); min-width: 0; }
  .member-post h3 { font-size: var(--text-lg); line-height: 1.4; overflow-wrap: anywhere; }
  .member-post > div > p { max-width: 62ch; color: var(--color-ink-2); line-height: 1.8; }
  .member-post__read { display: inline-flex; align-items: center; justify-self: end; gap: var(--space-xs); color: var(--color-accent); white-space: nowrap; }
  .member-post__read svg { width: 1em; height: 1em; }
  .member-game-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xl) var(--space-md); padding-block-start: var(--space-xl); }
  .member-game { display: grid; align-content: start; gap: var(--space-sm); min-width: 0; }
  .member-game__cover { width: 100%; aspect-ratio: 3 / 4; overflow: hidden; background: var(--color-paper-2); }
  .member-game__cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .member-game__cover > div { display: grid; height: 100%; place-items: center; color: var(--color-muted); }
  .member-game__cover svg { width: var(--space-xl); height: var(--space-xl); }
  .member-game__caption { display: grid; gap: var(--space-2xs); }
  .member-game h3 { font-size: var(--text-base); line-height: 1.45; overflow-wrap: anywhere; }
  .member-game__caption p { color: var(--color-accent); font-size: var(--text-sm); }
  .member-game__caption small { color: var(--color-muted); font-size: var(--text-xs); line-height: 1.5; }
  .section-empty { padding-block: var(--space-2xl); color: var(--color-muted); }
  @media (hover: hover) and (pointer: fine) { .member-post h3 a:hover, .member-socials a:hover { color: var(--color-accent); } }
  @media (min-width: 48rem) { .member-hero { grid-template-columns: 10rem minmax(0, 1fr) auto; align-items: end; } .member-avatar { width: 10rem; } .member-counts { grid-column: 3; grid-row: 1; align-self: stretch; min-width: 12rem; grid-template-columns: minmax(0, 1fr); border-block: 0; border-inline-start: var(--rule-hair) solid var(--color-rule); } .member-counts div { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: center; align-items: baseline; gap: var(--space-lg); padding: var(--space-md) 0 var(--space-md) var(--space-lg); } .member-counts div + div { padding-inline-start: var(--space-lg); border-inline-start: 0; border-block-start: var(--rule-hair) solid var(--color-rule); } .member-counts dd { font-size: var(--text-xl); text-align: end; } .member-post { grid-template-columns: 8rem minmax(0, 1fr); } .member-post__read { grid-column: 2; } }
  @media (min-width: 64rem) { .member-content { grid-template-columns: minmax(0, 1.7fr) minmax(20rem, 0.85fr); align-items: start; } .member-games { position: sticky; inset-block-start: 7rem; } }
  @media (max-width: 39.99rem) { .member-page { padding-block-start: var(--space-xl); } .member-hero { grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--space-lg) var(--space-md); } .member-avatar { width: 5.5rem; } .member-title h1 { font-size: var(--text-2xl); } .member-bio { font-size: var(--text-base); } .member-content { gap: var(--space-2xl); } .member-post h3 { font-size: var(--text-md); } }
</style>
