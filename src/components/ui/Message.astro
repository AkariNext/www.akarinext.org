---
/**
 * 保存の結果や入力の誤りを伝える一行。
 *
 * エディタごとに同じものが書かれていたので、ここへ集めた。
 * 読み上げの扱いが tone によって変わる（誤りは割り込んで読ませる）。
 */
interface Props {
	tone?: "notice" | "error";
	class?: string;
}

const { tone = "notice", class: className } = Astro.props;
---

<p
  class:list={["message", `message--${tone}`, className]}
  role={tone === "error" ? "alert" : "status"}
>
  <slot />
</p>

<style>
  .message {
    padding: var(--space-sm) var(--space-md);
    border: var(--rule-hair) solid var(--color-rule-strong);
    font-size: var(--text-sm);
  }

  .message--error {
    border-color: var(--color-error);
    color: var(--color-error);
  }
</style>
