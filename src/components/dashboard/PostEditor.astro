---
import { ArrowLeft, ExternalLink, Save, Settings2, Trash2 } from "lucide-astro";
import type { CmsPost, CmsSeries, CmsTag } from "../../lib/cms-types";

interface Props {
	action: string;
	post?: CmsPost;
	tags: CmsTag[];
	series: CmsSeries[];
	error?: string | null;
	notice?: string | null;
}

const { action, post, tags, series, error, notice } = Astro.props;
const selectedTags = new Set(post?.tags?.map((tag) => tag.id) ?? []);
const selectedSeries = post?.series?.id ?? "";

function localDateTime(value?: string | null): string {
	if (!value) return "";
	const date = new Date(value);
	if (Number.isNaN(date.getTime())) return "";
	const parts = new Intl.DateTimeFormat("sv-SE", {
		timeZone: "Asia/Tokyo",
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
		hour: "2-digit",
		minute: "2-digit",
		hour12: false,
	}).format(date);
	return parts.replace(" ", "T");
}

// 記事以外の設定は普段たたんでおく。書き始める前に触るものが多く、
// 執筆中はほとんど開かないため
const settingsOpen = Boolean(error);
---

<main class="editor">
  <!-- 書いている間もずっと見えていてほしいものだけを置く -->
  <header class="editor__bar">
    <div class="editor__bar-inner">
      <a class="editor__back" href="/dashboard"><ArrowLeft aria-hidden="true" /><span>ダッシュボード</span></a>

      <p class="editor__crumb">{post ? "記事を編集" : "新しい記事"}</p>

      <div class="editor__bar-actions">
        {post?.status === "published" && (
          <a class="editor__view" href={`/posts/${post.slug || post.id}`} target="_blank">
            <span>公開ページ</span><ExternalLink aria-hidden="true" />
          </a>
        )}
        <label class="editor__status">
          <span class="visually-hidden">状態</span>
          <select name="status" form="post-form">
            <option value="draft" selected={!post || post.status === "draft"}>下書き</option>
            <option value="published" selected={post?.status === "published"}>公開</option>
          </select>
        </label>
        <button class="editor__save" type="submit" form="post-form">
          <Save aria-hidden="true" /><span>{post ? "保存" : "作成"}</span>
        </button>
      </div>
    </div>
  </header>

  <div class="editor__messages" aria-live="polite">
    {error && <p class="editor__message editor__message--error" role="alert">{error}</p>}
    {notice && <p class="editor__message" role="status">保存しました。</p>}
  </div>

  <form id="post-form" class="editor__form" method="POST" action={action} enctype="multipart/form-data" data-astro-reload>
    <label class="editor__title">
      <span class="visually-hidden">タイトル</span>
      <input name="title" value={post?.title ?? ""} maxlength="160" required aria-required="true" placeholder="タイトルを入力" />
    </label>

    <div class="editor__panes" data-mode="write">
      <div class="editor__tabs" role="tablist" aria-label="本文の表示">
        <button type="button" role="tab" data-pane="write" aria-selected="true" aria-controls="pane-write">書く</button>
        <button type="button" role="tab" data-pane="preview" aria-selected="false" aria-controls="pane-preview">プレビュー</button>
      </div>

      <div class="editor__pane editor__pane--write" id="pane-write">
        <span class="editor__pane-label">本文 <small>Markdown</small></span>
        <textarea id="editor-content" name="content" spellcheck="true" placeholder="Markdown で書けます。画像は貼り付け・ドロップで挿入されます。">{post?.content ?? ""}</textarea>
      </div>

      <section class="editor__pane editor__pane--preview" id="pane-preview" aria-label="プレビュー">
        <span class="editor__pane-label">
          プレビュー
          <small data-preview-state aria-live="polite"></small>
        </span>
        <div class="editor__preview-body">
          <div class="prose" data-preview-body></div>
        </div>
      </section>
    </div>

    <details class="editor__settings" open={settingsOpen}>
      <summary><Settings2 aria-hidden="true" /><span>公開設定</span></summary>

      <div class="editor__settings-grid">
        <label class="field">
          <span>カテゴリー</span>
          <select name="category">
            <option value="tech" selected={post?.category === "tech"}>技術・開発</option>
            <option value="game" selected={post?.category === "game"}>ゲーム</option>
            <option value="misc" selected={!post || post.category === "misc"}>雑談</option>
          </select>
          <small aria-hidden="true">&nbsp;</small>
        </label>

        <label class="field">
          <span>公開日時</span>
          <input type="datetime-local" name="published_date" value={localDateTime(post?.published_date)} />
          <small>空のまま公開すると保存時刻が入ります。</small>
        </label>

        <label class="field">
          <span>URL名</span>
          <input name="slug" value={post?.slug ?? ""} pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="my-first-post" />
          <small>半角英数字とハイフン。空なら記事 ID を使います。</small>
        </label>

        <label class="field">
          <span>シリーズ</span>
          <select name="series">
            <option value="">所属なし</option>
            {series.map((item) => <option value={item.id} selected={selectedSeries === item.id}>{item.title}</option>)}
          </select>
          <small>公開済みのシリーズから選べます。</small>
        </label>

        <label class="field">
          <span>シリーズ内の順番</span>
          <input type="number" name="series_order" min="0" step="1" value={post?.series_order ?? ""} />
          <small aria-hidden="true">&nbsp;</small>
        </label>

        <fieldset class="field field--checks field--wide">
          <legend>タグ</legend>
          <div>
            {tags.length > 0 ? tags.map((tag) => (
              <label><input type="checkbox" name="tags" value={tag.id} checked={selectedTags.has(tag.id)} />{tag.name}</label>
            )) : <small>利用できるタグはありません。</small>}
          </div>
          <small aria-hidden="true">&nbsp;</small>
        </fieldset>

        <label class="field">
          <span>サムネイル</span>
          <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" />
          <small>JPEG・PNG・WebP・GIF、8 MB まで。</small>
        </label>

        {post?.image && (
          <div class="field editor__current-image">
            <span>現在のサムネイル</span>
            <img src={post.image.url} alt="" width="160" height="90" />
            <label><input type="checkbox" name="remove_image" />削除する</label>
          </div>
        )}

        <fieldset class="field field--checks">
          <legend>ネタバレ</legend>
          <div><label><input type="checkbox" name="is_spoiler" checked={post?.is_spoiler} />この記事にネタバレを含む</label></div>
          <small aria-hidden="true">&nbsp;</small>
        </fieldset>

        <label class="field field--wide">
          <span>ネタバレ警告文</span>
          <input name="spoiler_warning" maxlength="300" value={post?.spoiler_warning ?? ""} placeholder="終盤の内容を含みます" />
          <small>ネタバレを含む場合だけ入力します。</small>
        </label>
      </div>
    </details>
  </form>

  {post && (
    <details class="editor__danger">
      <summary><Trash2 aria-hidden="true" /><span>記事を削除</span></summary>
      <div class="editor__danger-body">
        <p>削除後は元に戻せません。確認のため記事タイトルを入力してください。</p>
        <form method="POST" action={action} data-astro-reload>
          <input type="hidden" name="_action" value="delete" />
          <label class="field">
            <span>記事タイトル</span>
            <input name="confirm_title" autocomplete="off" required />
            <small aria-hidden="true">&nbsp;</small>
          </label>
          <button type="submit"><Trash2 aria-hidden="true" />削除する</button>
        </form>
      </div>
    </details>
  )}
</main>

<script>
  import { onEachPage } from "../../scripts/on-page";
  import {
    enhanceMarkdownEditor,
    syncScroll,
  } from "../../scripts/markdown-editor";

  // 本文のライブプレビュー。
  // 変換はサーバー側の markdownToHtml に任せる（公開ページと同じ結果にするため）。
  onEachPage(() => {
  const panes = document.querySelector<HTMLElement>(".editor__panes");
  const textarea = document.querySelector<HTMLTextAreaElement>("#editor-content");
  const previewBody = document.querySelector<HTMLElement>("[data-preview-body]");
  const previewState = document.querySelector<HTMLElement>("[data-preview-state]");

  if (panes && textarea && previewBody && previewState && textarea.dataset.bound !== "true") {
    textarea.dataset.bound = "true";
    let timer: ReturnType<typeof setTimeout> | undefined;
    let lastRendered: string | null = null;
    let inFlight = false;
    let pending = false;

    const render = async (): Promise<void> => {
      const content = textarea.value;
      if (content === lastRendered) return;
      if (inFlight) {
        // 変換中に打鍵が続いた場合は、終わってから最新の内容で描き直す
        pending = true;
        return;
      }
      inFlight = true;
      previewState.textContent = "更新中…";
      try {
        const res = await fetch("/api/dashboard/preview", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ content }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = (await res.json()) as { html?: string };
        previewBody.innerHTML =
          data.html || '<p class="editor__preview-empty">まだ何も書かれていません。</p>';
        lastRendered = content;
        previewState.textContent = "";
      } catch {
        previewState.textContent = "プレビューを取得できませんでした";
      } finally {
        inFlight = false;
        if (pending) {
          pending = false;
          void render();
        }
      }
    };

    // タブ（狭い画面用。広い画面では CSS で両方表示する）
    for (const tab of panes.querySelectorAll<HTMLButtonElement>("[data-pane]")) {
      tab.addEventListener("click", () => {
        const mode = tab.dataset.pane ?? "write";
        panes.dataset.mode = mode;
        for (const other of panes.querySelectorAll<HTMLButtonElement>("[data-pane]")) {
          other.setAttribute("aria-selected", String(other === tab));
        }
        if (mode === "preview") void render();
      });
    }

    textarea.addEventListener("input", () => {
      clearTimeout(timer);
      // 打鍵のたびに叩かない。リンクカードは外部取得を伴うため間隔を広めに取る
      timer = setTimeout(() => void render(), 500);
    });

    // 書き心地の補助: リスト継続、装飾ショートカット、画像の貼り付け
    enhanceMarkdownEditor(textarea, {
      onChange: () => {
        clearTimeout(timer);
        timer = setTimeout(() => void render(), 500);
      },
      uploadImage: async (file) => {
        const form = new FormData();
        form.set("file", file);
        try {
          const res = await fetch("/api/dashboard/media", {
            method: "POST",
            body: form,
          });
          const data = (await res.json()) as { url?: string; error?: string };
          if (!res.ok || !data.url) {
            previewState.textContent = data.error || "画像を保存できませんでした";
            return null;
          }
          return data.url;
        } catch {
          previewState.textContent = "画像を保存できませんでした";
          return null;
        }
      },
    });

    // 書いている位置にプレビューを追従させる
    const previewScroller = previewBody.closest<HTMLElement>(".editor__preview-body");
    if (previewScroller) syncScroll(textarea, previewScroller);

    // 編集画面を開いた時点の内容を一度描画しておく
    void render();
  }
  });
</script>

<style>
  /* Hallmark · genre: editorial · macrostructure: Workbench · design-system: design.md · designed-as-app
   * 執筆中に見えるべきものだけを残し、本文とプレビューに横幅を明け渡す構成。
   */
  .editor { display: grid; align-content: start; min-height: 100dvh; }

  /* --- 上部バー：戻る・状態・保存だけを常時表示する --- */
  .editor__bar { position: sticky; inset-block-start: 0; z-index: 5; border-block-end: var(--rule-hair) solid var(--color-rule); background: var(--color-paper); }
  .editor__bar-inner { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-md); max-width: 120rem; margin-inline: auto; padding: var(--space-sm) var(--space-lg); }
  .editor__back { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; color: var(--color-accent); white-space: nowrap; }
  .editor__back svg { width: 1em; height: 1em; }
  .editor__crumb { color: var(--color-muted); font-size: var(--text-sm); text-align: center; }
  .editor__bar-actions { display: flex; align-items: center; gap: var(--space-sm); }
  .editor__view { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; color: var(--color-accent); white-space: nowrap; }
  .editor__view svg { width: 1em; height: 1em; }
  .editor__status select { min-height: 2.75rem; padding-inline: var(--space-md); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-ink); font: inherit; }
  .editor__save { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; padding-inline: var(--space-lg); border: var(--rule-hair) solid var(--color-accent); border-radius: var(--radius-sm); background: var(--color-accent); color: var(--color-accent-ink); font: inherit; cursor: pointer; white-space: nowrap; }
  .editor__save svg { width: 1em; height: 1em; }
  .editor__save:active { background: var(--color-ink); border-color: var(--color-ink); }

  .editor__messages:not(:empty) { max-width: 120rem; margin-inline: auto; padding-inline: var(--space-lg); }
  .editor__message { margin-block-start: var(--space-md); padding: var(--space-sm) var(--space-md); border: var(--rule-hair) solid var(--color-success); }
  .editor__message--error { border-color: var(--color-error); }

  /* --- 本文とプレビュー --- */
  .editor__form { display: grid; align-content: start; gap: var(--space-lg); width: 100%; max-width: 120rem; margin-inline: auto; padding: var(--space-lg) var(--space-lg) var(--space-2xl); }
  .editor__title input { width: 100%; min-height: 3.5rem; padding: var(--space-sm) var(--space-md); border: 0; border-block-end: var(--rule-hair) solid var(--color-rule); border-radius: 0; background: transparent; color: var(--color-ink); font-family: inherit; font-size: var(--text-xl); font-weight: 700; letter-spacing: -0.02em; }
  .editor__title input:focus { outline: 0; border-block-end-color: var(--color-accent); }
  .editor__title input::placeholder { color: var(--color-muted); font-weight: 400; }

  .editor__panes { display: grid; min-width: 0; gap: var(--space-md); }
  .editor__tabs { display: flex; gap: var(--space-xs); }
  .editor__tabs button { min-height: 2.75rem; padding-inline: var(--space-md); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-muted); font: inherit; cursor: pointer; }
  .editor__tabs button[aria-selected="true"] { border-color: var(--color-ink); background: var(--color-paper-2); color: var(--color-ink); font-weight: 700; }
  .editor__panes[data-mode="write"] .editor__pane--preview,
  .editor__panes[data-mode="preview"] .editor__pane--write { display: none; }
  .editor__pane { display: grid; min-width: 0; grid-template-rows: auto minmax(0, 1fr); gap: var(--space-xs); }
  .editor__pane-label { display: flex; align-items: baseline; gap: var(--space-sm); color: var(--color-muted); font-size: var(--text-xs); font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .editor__pane-label small { font-weight: 400; letter-spacing: 0; text-transform: none; }

  /* 画面の高さに合わせて伸ばす。書いている間に縦を最大限使えるように */
  .editor__pane textarea,
  .editor__preview-body { block-size: clamp(24rem, calc(100dvh - 18rem), 64rem); }
  .editor__pane textarea { width: 100%; padding: var(--space-md) var(--space-lg); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); outline: var(--rule-medium) solid transparent; outline-offset: var(--space-3xs); background: var(--color-paper); color: var(--color-ink); font: inherit; line-height: 1.8; resize: none; }
  .editor__pane textarea:focus { outline-color: var(--color-focus); }
  .editor__preview-body { overflow-y: auto; padding: var(--space-md) var(--space-lg); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); background: var(--color-paper); }
  .editor__preview-body .prose { max-width: none; }
  .editor__preview-empty { color: var(--color-muted); }

  /* --- 公開設定（たたんでおく） --- */
  .editor__settings, .editor__danger { border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-sm); }
  .editor__settings > summary, .editor__danger > summary { display: flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; padding: var(--space-sm) var(--space-md); font-size: var(--text-sm); font-weight: 700; cursor: pointer; }
  .editor__settings > summary svg, .editor__danger > summary svg { width: 1em; height: 1em; color: var(--color-accent); }
  .editor__settings-grid { display: grid; gap: var(--space-lg); padding: var(--space-md) var(--space-md) var(--space-lg); border-block-start: var(--rule-hair) solid var(--color-rule); }
  .field { display: grid; min-width: 0; align-content: start; gap: var(--space-xs); }
  .field > span, .field legend { font-size: var(--text-sm); font-weight: 700; }
  .field input:not([type="checkbox"]), .field select { width: 100%; min-height: 2.75rem; padding: var(--space-sm) var(--space-md); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); outline: var(--rule-medium) solid transparent; outline-offset: var(--space-3xs); background: var(--color-paper); color: var(--color-ink); font: inherit; }
  .field input:not([type="checkbox"]):focus, .field select:focus { outline-color: var(--color-focus); }
  .field small { min-height: 1lh; color: var(--color-muted); font-size: var(--text-xs); }
  .field--checks { border: 0; padding: 0; }
  .field--checks > div { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); }
  .field--checks label, .editor__current-image label { display: inline-flex; min-height: 2.75rem; align-items: center; gap: var(--space-xs); }
  input[type="checkbox"] { width: 1rem; height: 1rem; accent-color: var(--color-accent); }
  .editor__current-image img { width: 10rem; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: var(--color-paper-2); }

  /* --- 削除 --- */
  .editor__danger { max-width: 120rem; margin-inline: auto; margin-block-end: var(--space-2xl); width: calc(100% - var(--space-lg) * 2); border-color: var(--color-error); }
  .editor__danger > summary { color: var(--color-error); }
  .editor__danger > summary svg { color: var(--color-error); }
  .editor__danger-body { display: grid; gap: var(--space-md); padding: var(--space-md); border-block-start: var(--rule-hair) solid var(--color-error); }
  .editor__danger-body p { max-width: 65ch; color: var(--color-muted); font-size: var(--text-sm); }
  .editor__danger-body form { display: grid; gap: var(--space-md); }
  .editor__danger-body button { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-xs); min-height: 2.75rem; padding-inline: var(--space-lg); border: var(--rule-hair) solid var(--color-error); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-error); font: inherit; cursor: pointer; }
  .editor__danger-body button svg { width: 1em; height: 1em; }

  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (hover: hover) and (pointer: fine) {
    .editor__save:hover { background: var(--color-ink); border-color: var(--color-ink); }
    .editor__danger-body button:hover { background: var(--color-error); color: var(--color-accent-ink); }
    .field input:not([type="checkbox"]):hover, .field select:hover { background: var(--color-paper-2); }
  }

  /* 本文とプレビューを左右に並べる。設定はたたまれているので全幅を使える */
  @media (min-width: 64rem) {
    .editor__panes { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg); }
    .editor__tabs { display: none; }
    .editor__panes[data-mode="write"] .editor__pane--preview,
    .editor__panes[data-mode="preview"] .editor__pane--write { display: grid; }
    .editor__settings-grid { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
    .field--wide { grid-column: 1 / -1; }
    .editor__danger-body form { grid-template-columns: minmax(16rem, 28rem) auto; align-items: end; }
  }

  @media (max-width: 47.99rem) {
    .editor__bar-inner { grid-template-columns: auto auto; row-gap: var(--space-xs); padding-inline: var(--space-md); }
    .editor__crumb { display: none; }
    .editor__bar-actions { justify-content: end; }
    .editor__form { padding-inline: var(--space-md); }
    .editor__danger { width: calc(100% - var(--space-md) * 2); }
  }
</style>
