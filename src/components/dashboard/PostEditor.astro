---
import {
	ArrowLeft,
	ExternalLink,
	Save,
	SlidersHorizontal,
	Trash2,
} from "lucide-astro";
import type { CmsPost, CmsSeries, CmsTag } from "../../lib/cms-types";

interface Props {
	action: string;
	post?: CmsPost;
	tags: CmsTag[];
	series: CmsSeries[];
	error?: string | null;
	notice?: string | null;
}

const { action, post, tags, series, error, notice } = Astro.props;
const selectedTags = new Set(post?.tags?.map((tag) => tag.id) ?? []);
const selectedSeries = post?.series?.id ?? "";
const isPublished = post?.status === "published";

function localDateTime(value?: string | null): string {
	if (!value) return "";
	const date = new Date(value);
	if (Number.isNaN(date.getTime())) return "";
	const parts = new Intl.DateTimeFormat("sv-SE", {
		timeZone: "Asia/Tokyo",
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
		hour: "2-digit",
		minute: "2-digit",
		hour12: false,
	}).format(date);
	return parts.replace(" ", "T");
}

/** ツールバー。glyph はアイコンではなく記法そのものを見せる */
const tools = [
	{ command: "bold", glyph: "B", label: "太字", hint: "Ctrl/⌘ + B" },
	{ command: "italic", glyph: "I", label: "斜体", hint: "Ctrl/⌘ + I" },
	{ command: "link", glyph: "[ ]", label: "リンク", hint: "Ctrl/⌘ + K" },
	{ command: "heading", glyph: "H2", label: "見出し", hint: "Ctrl/⌘ + Shift + H" },
	{ command: "list", glyph: "•", label: "箇条書き", hint: "Ctrl/⌘ + Shift + L" },
	{ command: "quote", glyph: "❝", label: "引用", hint: "Ctrl/⌘ + Shift + Q" },
	{ command: "code", glyph: "</>", label: "コード", hint: "Ctrl/⌘ + Shift + C" },
] as const;
---

<main class="editor">
  <!-- 書いている間もずっと見えていてほしいものだけを置く -->
  <header class="editor__bar">
    <div class="editor__bar-inner">
      <a class="editor__back" href="/dashboard"><ArrowLeft aria-hidden="true" /><span>ダッシュボード</span></a>

      <div class="editor__status-line">
        <p class="editor__crumb">{post ? "記事を編集" : "新しい記事"}</p>
        <small data-preview-state aria-live="polite"></small>
      </div>

      <div class="editor__bar-actions">
        {isPublished && post && (
          <a class="editor__view" href={`/posts/${post.slug || post.id}`} target="_blank" rel="noopener noreferrer">
            <span>公開ページ</span><ExternalLink aria-hidden="true" />
          </a>
        )}

        <div class="segmented" role="group" aria-label="状態">
          <label>
            <input type="radio" name="status" value="draft" form="post-form" checked={!isPublished} />
            <span>下書き</span>
          </label>
          <label>
            <input type="radio" name="status" value="published" form="post-form" checked={isPublished} />
            <span>公開</span>
          </label>
        </div>

        <button class="button button--primary" type="submit" form="post-form">
          <Save aria-hidden="true" /><span>{post ? "保存" : "作成"}</span>
        </button>
      </div>
    </div>
  </header>

  {(error || notice) && (
    <div class="editor__alert">
      <p class:list={["message", { "message--error": error }]} role={error ? "alert" : "status"}>
        {error || "保存しました。"}
      </p>
    </div>
  )}

  <div class="editor__layout" data-mode="split">
    <form id="post-form" class="editor__form" method="POST" action={action} enctype="multipart/form-data" data-astro-reload>
      <label class="editor__title">
        <span class="visually-hidden">タイトル</span>
        <input name="title" value={post?.title ?? ""} maxlength="160" required aria-required="true" placeholder="タイトルを入力" />
      </label>

      <div class="editor__controls">
        <div class="toolbar" role="toolbar" aria-label="本文の書式">
          {tools.map((tool) => (
            <button type="button" data-command={tool.command} aria-label={tool.label} title={`${tool.label}（${tool.hint}）`}>
              {tool.glyph}
            </button>
          ))}
          <span class="toolbar__hint">選んでから * ` ~ ( [ 「 などを押すと囲めます。画像は貼り付け・ドロップで入ります</span>
        </div>

        <div class="viewtabs" role="tablist" aria-label="表示">
          <button type="button" role="tab" data-view="split" aria-selected="true">2列</button>
          <button type="button" role="tab" data-view="write" aria-selected="false">書くだけ</button>
          <button type="button" role="tab" data-view="preview" aria-selected="false" class="viewtabs__preview">プレビュー</button>
          <button type="button" role="tab" data-view="settings" aria-selected="false" class="viewtabs__settings">設定</button>
        </div>
      </div>

      <div class="editor__panes">
        <div class="pane pane--write" id="pane-write">
          <span class="pane__label">
            <span>本文 <small>Markdown</small></span>
            <small data-char-count>0 字</small>
          </span>
          <div class="editor__mount" data-editor-mount>
            <textarea id="editor-content" name="content" spellcheck="true" placeholder="Markdown で書けます。画像は貼り付け・ドロップで挿入されます。">{post?.content ?? ""}</textarea>
          </div>
        </div>

        <section class="pane pane--preview" id="pane-preview" aria-label="プレビュー">
          <span class="pane__label"><span>プレビュー</span></span>
          <div class="editor__preview-body">
            <div class="prose" data-preview-body></div>
          </div>
        </section>
      </div>
    </form>

    <aside class="settings" id="pane-settings" aria-label="公開設定">
      <div class="settings__head">
        <SlidersHorizontal aria-hidden="true" />
        <span>公開設定</span>
      </div>

      <div class="settings__body">
        <label class="field">
          <span>公開日時</span>
          <input type="datetime-local" name="published_date" form="post-form" value={localDateTime(post?.published_date)} />
          <small>空のまま公開すると保存時刻が入ります。</small>
        </label>

        <label class="field">
          <span>URL名</span>
          <input class="field--mono" name="slug" form="post-form" value={post?.slug ?? ""} pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="my-first-post" />
          <small>半角英数字とハイフン。空なら記事 ID を使います。</small>
        </label>
      </div>

      <details class="settings__group" open>
        <summary>分類</summary>
        <div class="settings__body">
          <label class="field">
            <span>カテゴリー</span>
            <select name="category" form="post-form">
              <option value="tech" selected={post?.category === "tech"}>技術・開発</option>
              <option value="game" selected={post?.category === "game"}>ゲーム</option>
              <option value="misc" selected={!post || post.category === "misc"}>雑談</option>
            </select>
          </label>

          <label class="field">
            <span>シリーズ</span>
            <select name="series" form="post-form">
              <option value="">所属なし</option>
              {series.map((item) => <option value={item.id} selected={selectedSeries === item.id}>{item.title}</option>)}
            </select>
          </label>

          <label class="field">
            <span>シリーズ内の順番</span>
            <input type="number" name="series_order" form="post-form" min="0" step="1" value={post?.series_order ?? ""} />
          </label>

          <fieldset class="field field--checks">
            <legend>タグ</legend>
            <div>
              {tags.length > 0 ? tags.map((tag) => (
                <label><input type="checkbox" name="tags" form="post-form" value={tag.id} checked={selectedTags.has(tag.id)} />{tag.name}</label>
              )) : <small>利用できるタグはありません。</small>}
            </div>
          </fieldset>
        </div>
      </details>

      <details class="settings__group">
        <summary>サムネイル</summary>
        <div class="settings__body">
          <label class="field">
            <span class="visually-hidden">画像を選ぶ</span>
            <input type="file" name="image" form="post-form" accept="image/jpeg,image/png,image/webp,image/gif" />
            <small>JPEG・PNG・WebP・GIF、8 MB まで。</small>
          </label>
          {post?.image && (
            <div class="settings__thumb">
              <img src={post.image.url} alt="" width="160" height="90" />
              <label><input type="checkbox" name="remove_image" form="post-form" />現在の画像を削除</label>
            </div>
          )}
        </div>
      </details>

      <details class="settings__group">
        <summary>ネタバレ</summary>
        <div class="settings__body">
          <fieldset class="field field--checks">
            <legend class="visually-hidden">ネタバレ</legend>
            <div><label><input type="checkbox" name="is_spoiler" form="post-form" checked={post?.is_spoiler} />この記事にネタバレを含む</label></div>
          </fieldset>
          <label class="field">
            <span>警告文</span>
            <input name="spoiler_warning" form="post-form" maxlength="300" value={post?.spoiler_warning ?? ""} placeholder="終盤の内容を含みます" />
            <small>ネタバレを含む場合だけ入力します。</small>
          </label>
        </div>
      </details>

      {post && (
        <details class="settings__group settings__group--danger">
          <summary>この記事を削除</summary>
          <div class="settings__body">
            <p>削除後は元に戻せません。確認のため記事タイトルを入力してください。</p>
            <form method="POST" action={action} data-astro-reload>
              <input type="hidden" name="_action" value="delete" />
              <label class="field">
                <span class="visually-hidden">記事タイトル</span>
                <input name="confirm_title" autocomplete="off" required placeholder={post.title} />
              </label>
              <button class="button button--danger" type="submit"><Trash2 aria-hidden="true" />削除する</button>
            </form>
          </div>
        </details>
      )}
    </aside>
  </div>
</main>

<script>
  import { onEachPage } from "../../scripts/on-page";
  import {
    createMarkdownEditor,
    editorCommands,
    syncScroll,
  } from "../../scripts/markdown-editor";

  onEachPage(() => {
    const layout = document.querySelector<HTMLElement>(".editor__layout");
    const textarea = document.querySelector<HTMLTextAreaElement>("#editor-content");
    const previewBody = document.querySelector<HTMLElement>("[data-preview-body]");
    const previewState = document.querySelector<HTMLElement>("[data-preview-state]");
    const charCount = document.querySelector<HTMLElement>("[data-char-count]");
    if (!layout || !textarea || !previewBody || !previewState) return;
    if (textarea.dataset.bound === "true") return;
    textarea.dataset.bound = "true";

    let timer: ReturnType<typeof setTimeout> | undefined;
    let lastRendered: string | null = null;
    let inFlight = false;
    let pending = false;

    // 変換は公開ページと同じ markdownToHtml に任せる。ブラウザ側で別実装を持つと見え方がズレる
    const render = async (): Promise<void> => {
      const content = textarea.value;
      if (content === lastRendered) return;
      if (inFlight) {
        pending = true;
        return;
      }
      inFlight = true;
      previewState.textContent = "更新中…";
      try {
        const res = await fetch("/api/dashboard/preview", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ content }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = (await res.json()) as { html?: string };
        previewBody.innerHTML =
          data.html || '<p class="preview-empty">まだ何も書かれていません。</p>';
        lastRendered = content;
        previewState.textContent = "";
      } catch {
        previewState.textContent = "プレビューを取得できませんでした";
      } finally {
        inFlight = false;
        if (pending) {
          pending = false;
          void render();
        }
      }
    };

    const schedule = () => {
      if (charCount) {
        charCount.textContent = `${textarea.value.length.toLocaleString("ja-JP")} 字`;
      }
      clearTimeout(timer);
      // 打鍵のたびに叩かない。リンクカードは外部取得を伴うため間隔を広めに取る
      timer = setTimeout(() => void render(), 500);
    };

    const editor = createMarkdownEditor({
      textarea,
      parent:
        document.querySelector<HTMLElement>("[data-editor-mount]") ??
        textarea.parentElement ??
        document.body,
      onChange: schedule,
      uploadImage: async (file: File) => {
        const form = new FormData();
        form.set("file", file);
        try {
          const res = await fetch("/api/dashboard/media", { method: "POST", body: form });
          const data = (await res.json()) as { url?: string; error?: string };
          if (!res.ok || !data.url) {
            previewState.textContent = data.error || "画像を保存できませんでした";
            return null;
          }
          return data.url;
        } catch {
          previewState.textContent = "画像を保存できませんでした";
          return null;
        }
      },
    });

    // 書式ボタン。ショートカットと同じ実装を呼ぶ
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-command]")) {
      // クリックでフォーカスが移ると選択範囲が消えてしまうので、既定動作を止める
      button.addEventListener("mousedown", (event) => event.preventDefault());
      button.addEventListener("click", () => {
        const run = editorCommands[button.dataset.command as keyof typeof editorCommands];
        if (run) run(editor);
      });
    }

    // 表示の切り替え。狭い画面では「書く / プレビュー / 設定」の 3 択になる
    const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-view]")];
    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const view = tab.dataset.view ?? "split";
        layout.dataset.mode = view;
        for (const other of tabs) {
          other.setAttribute("aria-selected", String(other === tab));
        }
        if (view === "preview" || view === "split") void render();
      });
    }

    const previewScroller = previewBody.closest<HTMLElement>(".editor__preview-body");
    if (previewScroller) syncScroll(editor, previewScroller);

    schedule();
    void render();
  });
</script>

<style>
  /* Hallmark · genre: editorial · macrostructure: Workbench · design-system: design.md · designed-as-app
   * 書いている間に触るものだけを上に固定し、本文とプレビューに横幅を渡す。
   * 公開設定は右の柱にまとめ、狭い画面ではタブの 1 つとして開く。
   */
  .editor { display: grid; align-content: start; min-height: 100dvh; }

  /* --- 上部バー --- */
  .editor__bar { position: sticky; inset-block-start: 0; z-index: 5; border-block-end: var(--rule-hair) solid var(--color-rule); background: var(--color-paper); }
  .editor__bar-inner { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-md); max-width: 120rem; margin-inline: auto; padding: var(--space-sm) var(--space-lg); }
  .editor__back { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; color: var(--color-accent); white-space: nowrap; }
  .editor__back svg { width: 1em; height: 1em; }
  .editor__status-line { display: flex; align-items: center; justify-content: center; gap: var(--space-sm); min-width: 0; }
  .editor__crumb { color: var(--color-muted); font-size: var(--text-sm); white-space: nowrap; }
  .editor__status-line small { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-xs); white-space: nowrap; }
  .editor__bar-actions { display: flex; align-items: center; gap: var(--space-sm); }
  .editor__view { display: inline-flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; color: var(--color-accent); font-size: var(--text-sm); white-space: nowrap; }
  .editor__view svg { width: 1em; height: 1em; }

  /* 状態は radio で組む。JS が無くても切り替えて送信できる */
  .segmented { display: flex; overflow: hidden; border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); }
  .segmented label { display: inline-flex; }
  .segmented input { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .segmented span { display: inline-flex; min-height: 2.75rem; align-items: center; padding-inline: var(--space-md); background: var(--color-paper); color: var(--color-ink-2); font-size: var(--text-sm); white-space: nowrap; cursor: pointer; }
  .segmented label + label span { border-inline-start: var(--rule-hair) solid var(--color-rule-strong); }
  .segmented input:checked + span { background: var(--color-ink); color: var(--color-accent-ink); font-weight: 700; }
  .segmented input:focus-visible + span { outline: var(--rule-medium) solid var(--color-focus); outline-offset: -2px; }

  .button { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; gap: var(--space-xs); padding-inline: var(--space-lg); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-ink); font: inherit; font-size: var(--text-sm); cursor: pointer; white-space: nowrap; }
  .button svg { width: 1em; height: 1em; }
  .button--primary { border-color: var(--color-accent); background: var(--color-accent); color: var(--color-accent-ink); }
  .button--danger { border-color: var(--color-error); background: var(--color-paper); color: var(--color-error); }

  .editor__alert { max-width: 120rem; margin-inline: auto; width: 100%; padding: var(--space-md) var(--space-lg) 0; }
  .message { padding: var(--space-sm) var(--space-md); border: var(--rule-hair) solid var(--color-success); font-size: var(--text-sm); }
  .message--error { border-color: var(--color-error); color: var(--color-error); }

  /* --- 本文まわり --- */
  .editor__layout { display: grid; gap: var(--space-xl); width: 100%; max-width: 120rem; margin-inline: auto; padding: var(--space-lg) var(--space-lg) var(--space-2xl); }
  .editor__form { display: grid; align-content: start; gap: var(--space-md); min-width: 0; }
  .editor__title input { width: 100%; min-height: 3.5rem; padding: var(--space-sm) 0; border: 0; border-block-end: var(--rule-hair) solid var(--color-rule); border-radius: 0; background: transparent; color: var(--color-ink); font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; letter-spacing: -0.02em; }
  .editor__title input:focus { outline: 0; border-block-end-color: var(--color-accent); }
  .editor__title input::placeholder { color: var(--color-muted); font-weight: 400; }

  .editor__controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-md); }
  .toolbar { display: flex; align-items: center; gap: var(--space-2xs); min-width: 0; }
  .toolbar button { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-ink-2); font-family: var(--font-mono); font-size: var(--text-sm); cursor: pointer; }
  .toolbar__hint { padding-inline-start: var(--space-sm); color: var(--color-muted); font-size: var(--text-xs); }
  .viewtabs { display: flex; gap: var(--space-xs); }
  .viewtabs button { display: inline-flex; min-height: 2.5rem; align-items: center; padding-inline: var(--space-md); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-muted); font: inherit; font-size: var(--text-sm); cursor: pointer; white-space: nowrap; }
  .viewtabs button[aria-selected="true"] { border-color: var(--color-ink); background: var(--color-paper-2); color: var(--color-ink); font-weight: 700; }

  .editor__panes { display: grid; gap: var(--space-lg); min-width: 0; }
  .pane { display: grid; grid-template-rows: auto minmax(0, 1fr); gap: var(--space-xs); min-width: 0; }
  .pane__label { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-sm); color: var(--color-muted); font-size: var(--text-xs); font-weight: 700; letter-spacing: .04em; }
  .pane__label small { font-family: var(--font-mono); font-weight: 400; letter-spacing: 0; }
  .pane__label span small { font-family: inherit; }

  /* 画面の高さに合わせて伸ばす */
  .editor__mount,
  .editor__preview-body { block-size: clamp(24rem, calc(100dvh - 22rem), 64rem); }
  .editor__mount { min-width: 0; }
  /* JS が動かないときも書けるよう、素の textarea にも体裁を与える */
  .editor__mount textarea { width: 100%; height: 100%; padding: var(--space-md) var(--space-lg); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-ink); font: inherit; line-height: 1.8; resize: none; }
  .editor__preview-body { overflow-y: auto; padding: var(--space-md) var(--space-lg); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); background: var(--color-paper); }
  .editor__preview-body .prose { max-width: none; }
  .preview-empty { color: var(--color-muted); }

  /* --- 公開設定 --- */
  .settings { display: grid; align-content: start; border: var(--rule-hair) solid var(--color-rule-strong); background: var(--color-paper); }
  .settings__head { display: flex; align-items: center; gap: var(--space-xs); min-height: 2.75rem; padding: var(--space-sm) var(--space-md); border-block-end: var(--rule-hair) solid var(--color-rule); font-size: var(--text-sm); font-weight: 700; }
  .settings__head svg { width: 1em; height: 1em; color: var(--color-accent); }
  .settings__body { display: grid; gap: var(--space-md); padding: var(--space-md); }
  .settings__group { border-block-start: var(--rule-hair) solid var(--color-rule); }
  .settings__group > summary { display: flex; align-items: center; justify-content: space-between; min-height: 2.75rem; padding: var(--space-xs) var(--space-md); font-size: var(--text-sm); font-weight: 700; cursor: pointer; }
  .settings__group--danger > summary { color: var(--color-error); }
  .settings__group--danger p { color: var(--color-muted); font-size: var(--text-sm); }
  .settings__group--danger form { display: grid; gap: var(--space-sm); }
  .settings__thumb { display: grid; gap: var(--space-xs); }
  .settings__thumb img { width: 100%; max-width: 10rem; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: var(--color-paper-2); }

  .field { display: grid; min-width: 0; gap: var(--space-xs); }
  .field > span, .field legend { font-size: var(--text-sm); font-weight: 700; }
  .field input:not([type="checkbox"]), .field select { width: 100%; min-height: 2.75rem; padding: var(--space-sm) var(--space-md); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); outline: var(--rule-medium) solid transparent; outline-offset: var(--space-3xs); background: var(--color-paper); color: var(--color-ink); font: inherit; }
  .field--mono { font-family: var(--font-mono); font-size: var(--text-sm); }
