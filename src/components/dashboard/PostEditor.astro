---
import { ArrowLeft, ExternalLink, Save, Trash2 } from "lucide-astro";
import type { CmsPost, CmsSeries, CmsTag } from "../../lib/cms-types";

interface Props {
	action: string;
	post?: CmsPost;
	tags: CmsTag[];
	series: CmsSeries[];
	error?: string | null;
	notice?: string | null;
}

const { action, post, tags, series, error, notice } = Astro.props;
const selectedTags = new Set(post?.tags?.map((tag) => tag.id) ?? []);
const selectedSeries = post?.series?.id ?? "";

function localDateTime(value?: string | null): string {
	if (!value) return "";
	const date = new Date(value);
	if (Number.isNaN(date.getTime())) return "";
	const parts = new Intl.DateTimeFormat("sv-SE", {
		timeZone: "Asia/Tokyo",
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
		hour: "2-digit",
		minute: "2-digit",
		hour12: false,
	}).format(date);
	return parts.replace(" ", "T");
}
---

<main class="editor container">
  <header class="editor__head">
    <a class="editor__back" href="/dashboard"><ArrowLeft aria-hidden="true" />ダッシュボード</a>
    <div>
      <p>Writing desk</p>
      <h1>{post ? "記事を編集" : "新しい記事"}</h1>
    </div>
    {post?.status === "published" && (
      <a class="editor__preview" href={`/posts/${post.slug || post.id}`} target="_blank">
        公開ページ <ExternalLink aria-hidden="true" />
      </a>
    )}
  </header>

  {error && <p class="editor__message editor__message--error" role="alert">{error}</p>}
  {notice && <p class="editor__message" role="status">保存しました。</p>}

  <form class="editor__form" method="POST" action={action} enctype="multipart/form-data">
    <div class="editor__writing">
      <label class="field">
        <span>タイトル <b>必須</b></span>
        <input name="title" value={post?.title ?? ""} maxlength="160" required aria-required="true" />
        <small>一覧と記事ページに表示されます。</small>
      </label>

      <label class="field">
        <span>本文 <b>Markdown</b></span>
        <textarea name="content" rows="24" spellcheck="true">{post?.content ?? ""}</textarea>
        <small>見出し、リスト、リンク、画像など Markdown 記法を使えます。</small>
      </label>
    </div>

    <aside class="editor__settings" aria-label="公開設定">
      <h2>公開設定</h2>
      <label class="field">
        <span>状態</span>
        <select name="status">
          <option value="draft" selected={!post || post.status === "draft"}>下書き</option>
          <option value="published" selected={post?.status === "published"}>公開</option>
        </select>
        <small>公開を選ぶとサイトに表示されます。</small>
      </label>

      <label class="field">
        <span>カテゴリー</span>
        <select name="category">
          <option value="tech" selected={post?.category === "tech"}>技術・開発</option>
          <option value="game" selected={post?.category === "game"}>ゲーム</option>
          <option value="misc" selected={!post || post.category === "misc"}>雑談</option>
        </select>
        <small aria-hidden="true">&nbsp;</small>
      </label>

      <label class="field">
        <span>公開日時</span>
        <input type="datetime-local" name="published_date" value={localDateTime(post?.published_date)} />
        <small>空のまま公開すると保存時刻が入ります。</small>
      </label>

      <label class="field">
        <span>URL名</span>
        <input name="slug" value={post?.slug ?? ""} pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="my-first-post" />
        <small>半角英数字とハイフン。空なら記事 ID を使います。</small>
      </label>

      <fieldset class="field field--checks">
        <legend>タグ</legend>
        <div>
          {tags.length > 0 ? tags.map((tag) => (
            <label><input type="checkbox" name="tags" value={tag.id} checked={selectedTags.has(tag.id)} />{tag.name}</label>
          )) : <small>利用できるタグはありません。</small>}
        </div>
        <small aria-hidden="true">&nbsp;</small>
      </fieldset>

      <label class="field">
        <span>シリーズ</span>
        <select name="series">
          <option value="">所属なし</option>
          {series.map((item) => <option value={item.id} selected={selectedSeries === item.id}>{item.title}</option>)}
        </select>
        <small>公開済みのシリーズから選べます。</small>
      </label>

      <label class="field">
        <span>シリーズ内の順番</span>
        <input type="number" name="series_order" min="0" step="1" value={post?.series_order ?? ""} />
        <small aria-hidden="true">&nbsp;</small>
      </label>

      <fieldset class="field field--checks">
        <legend>ネタバレ</legend>
        <div><label><input type="checkbox" name="is_spoiler" checked={post?.is_spoiler} />この記事にネタバレを含む</label></div>
        <small aria-hidden="true">&nbsp;</small>
      </fieldset>

      <label class="field">
        <span>ネタバレ警告文</span>
        <input name="spoiler_warning" maxlength="300" value={post?.spoiler_warning ?? ""} placeholder="終盤の内容を含みます" />
        <small>必要な場合だけ入力します。</small>
      </label>

      <label class="field">
        <span>サムネイル</span>
        <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" />
        <small>JPEG・PNG・WebP・GIF、8 MB まで。</small>
      </label>
      {post?.image && (
        <div class="editor__current-image">
          <img src={post.image.url} alt="現在のサムネイル" width="160" height="90" />
          <label><input type="checkbox" name="remove_image" />現在の画像を削除</label>
        </div>
      )}

      <button class="editor__save" type="submit"><Save aria-hidden="true" />{post ? "変更を保存" : "記事を作成"}</button>
    </aside>
  </form>

  {post && (
    <section class="editor__danger">
      <div>
        <h2>記事を削除</h2>
        <p>削除後は元に戻せません。確認のため記事タイトルを入力してください。</p>
      </div>
      <form method="POST" action={action}>
        <input type="hidden" name="_action" value="delete" />
        <label class="field">
          <span>記事タイトル</span>
          <input name="confirm_title" autocomplete="off" required />
          <small aria-hidden="true">&nbsp;</small>
        </label>
        <button type="submit"><Trash2 aria-hidden="true" />削除する</button>
      </form>
    </section>
  )}
</main>

<style>
  /* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4
   * genre: editorial · macrostructure: Index-First · tone: practical cool blue · contrast: pass (40–41)
   */
  .editor { padding-block: var(--space-xl) var(--space-4xl); }
  .editor__head { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-md); align-items: end; padding-block-end: var(--space-xl); border-block-end: var(--rule-medium) solid var(--color-ink); }
  .editor__head > div > p { color: var(--color-accent); font-size: var(--text-sm); font-weight: 700; }
  .editor__head h1 { margin-block-start: var(--space-xs); font-size: clamp(var(--text-xl), 5vw, var(--text-2xl)); line-height: 1.1; }
  .editor__back, .editor__preview { display: inline-flex; width: fit-content; min-height: 2.75rem; align-items: center; gap: var(--space-xs); color: var(--color-accent); white-space: nowrap; }
  .editor__back svg, .editor__preview svg { width: 1em; height: 1em; }
  .editor__message { margin-block-start: var(--space-lg); padding: var(--space-sm) var(--space-md); border: var(--rule-hair) solid var(--color-success); color: var(--color-ink); }
  .editor__message--error { border-color: var(--color-error); }
  .editor__form { display: grid; gap: var(--space-xl); padding-block: var(--space-xl) var(--space-2xl); }
  .editor__writing, .editor__settings { display: grid; min-width: 0; align-content: start; gap: var(--space-lg); }
  .editor__settings { padding-block-start: var(--space-lg); border-block-start: var(--rule-hair) solid var(--color-rule); }
  .editor__settings h2 { font-size: var(--text-lg); }
  .field { display: grid; min-width: 0; gap: var(--space-xs); }
  .field > span, .field legend { font-size: var(--text-sm); font-weight: 700; }
  .field > span b { margin-inline-start: var(--space-xs); color: var(--color-muted); font-size: var(--text-xs); }
  .field input:not([type="checkbox"]), .field textarea, .field select { width: 100%; min-height: 2.75rem; padding: var(--space-sm) var(--space-md); border: var(--rule-hair) solid var(--color-rule-strong); border-radius: var(--radius-sm); outline: var(--rule-medium) solid transparent; outline-offset: var(--space-3xs); background: var(--color-paper); color: var(--color-ink); font: inherit; }
  .field textarea { min-height: 32rem; resize: vertical; line-height: 1.75; }
  .field input::placeholder, .field textarea::placeholder { color: var(--color-muted); }
  .field input:not([type="checkbox"]):focus, .field textarea:focus, .field select:focus { outline-color: var(--color-focus); }
  .field input:disabled, .field textarea:disabled, .field select:disabled { cursor: not-allowed; opacity: .55; }
  .field small { min-height: 1lh; color: var(--color-muted); font-size: var(--text-xs); }
  .field--checks { border: 0; }
  .field--checks > div { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); }
  .field--checks label, .editor__current-image label { display: inline-flex; min-height: 2.75rem; align-items: center; gap: var(--space-xs); }
  input[type="checkbox"] { width: 1rem; height: 1rem; accent-color: var(--color-accent); }
  .editor__current-image { display: grid; gap: var(--space-xs); }
  .editor__current-image img { width: 10rem; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: var(--color-paper-2); }
  .editor__save, .editor__danger button { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; gap: var(--space-xs); padding-inline: var(--space-lg); border: var(--rule-hair) solid var(--color-accent); border-radius: var(--radius-sm); background: var(--color-accent); color: var(--color-accent-ink); cursor: pointer; white-space: nowrap; }
  .editor__save svg, .editor__danger button svg { width: 1em; height: 1em; }
  .editor__save:active, .editor__danger button:active { background: var(--color-ink); }
  .editor__save:disabled, .editor__danger button:disabled { cursor: not-allowed; opacity: .55; }
  .editor__danger { display: grid; gap: var(--space-lg); padding-block: var(--space-xl); border-block: var(--rule-hair) solid var(--color-error); }
  .editor__danger h2 { font-size: var(--text-md); }
  .editor__danger p { max-width: 65ch; color: var(--color-muted); }
  .editor__danger form { display: grid; gap: var(--space-md); }
  .editor__danger button { border-color: var(--color-error); background: var(--color-paper); color: var(--color-error); }
  @media (hover: hover) and (pointer: fine) {
    .field input:not([type="checkbox"]):hover, .field textarea:hover, .field select:hover { background: var(--color-paper-2); }
    .editor__save:hover { background: var(--color-ink); border-color: var(--color-ink); }
    .editor__danger button:hover { background: var(--color-error); color: var(--color-accent-ink); }
  }
  @media (min-width: 40rem) {
    .editor__head { grid-template-columns: auto minmax(0, 1fr) auto; }
    .editor__head > div { padding-inline-start: var(--space-lg); }
    .editor__danger form { grid-template-columns: minmax(16rem, 28rem) auto; align-items: end; }
  }
  @media (min-width: 60rem) {
    .editor__form { grid-template-columns: minmax(0, 2fr) minmax(18rem, .85fr); gap: var(--space-2xl); }
    .editor__settings { padding-block-start: 0; padding-inline-start: var(--space-xl); border-block-start: 0; border-inline-start: var(--rule-hair) solid var(--color-rule); }
  }
</style>
