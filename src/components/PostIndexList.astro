---
import { ArrowRight, BookOpen } from "lucide-astro";
import { type CmsPost, getMediaUrl } from "../lib/cms";

interface Props {
	posts: CmsPost[];
	emptyMessage?: string;
}

const { posts, emptyMessage = "記事が見つかりませんでした。" } = Astro.props;
const date = (post: CmsPost) =>
	new Date(post.published_date || post.createdAt).toLocaleDateString("ja-JP", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
const excerpt = (post: CmsPost) =>
	post.is_spoiler
		? "この記事にはネタバレが含まれています。"
		: post.content
				?.replace(/[#*_`>!|]/g, " ")
				.replaceAll("[", " ")
				.replaceAll("]", " ")
				.replace(/\s+/g, " ")
				.trim()
				.slice(0, 135) || "本文を読む";
const url = (post: CmsPost) => `/posts/${post.slug || post.id}`;
---

{posts.length > 0 ? <div class="article-index">{posts.map((post, index) => {
  const image = getMediaUrl(post.image);
  const postAuthor = typeof post.author === "object" && post.author ? post.author : null;
  const authorName = postAuthor?.name || postAuthor?.username || "AkariNext";
  const authorAvatar = getMediaUrl(postAuthor?.avatar);
  const authorInitial = authorName.trim().charAt(0).toUpperCase() || "A";
  return <article class:list={["article-row", { "article-row--lead": index === 0, "article-row--with-image": Boolean(image) }]}>
    <div class="article-row__meta">
      <time datetime={post.published_date || post.createdAt}>{date(post)}</time>
      {postAuthor ? <a class="article-row__author" href={`/users/${postAuthor.id}`} aria-label={`${authorName}のプロフィールを見る`}>
        <span class="article-row__avatar" aria-hidden="true">{authorAvatar ? <img src={authorAvatar} alt="" width="32" height="32" loading="lazy" decoding="async" /> : <span>{authorInitial}</span>}</span>
        <span>{authorName}</span>
      </a> : <span class="article-row__author"><span class="article-row__avatar" aria-hidden="true"><span>{authorInitial}</span></span><span>{authorName}</span></span>}
    </div>
    <div class="article-row__body">
      <h2><a href={url(post)}>{post.title}</a></h2>
      <p>{excerpt(post)}</p>
      {post.tags && post.tags.length > 0 && <div class="article-row__foot"><div class="article-row__tags">{post.tags.slice(0, 3).map((item) => <a href={`/tags/${item.slug}`}>#{item.name}</a>)}</div></div>}
    </div>
    {image && <a href={url(post)} class="article-row__image" aria-label={`${post.title}を読む`}><img src={image} alt="" loading={index === 0 ? "eager" : "lazy"} decoding="async" /></a>}
    <a href={url(post)} class="read-link" aria-label={`${post.title}を読む`}>読む <ArrowRight aria-hidden="true" /></a>
  </article>;
})}</div> : <div class="posts-empty"><BookOpen aria-hidden="true" /><h2>{emptyMessage}</h2><p>後でもう一度確認してください。</p><a href="/posts">すべての記事を見る</a></div>}

<style>
  .article-row { display: grid; gap: var(--space-lg); padding-block: var(--space-xl); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .article-row:last-child { border-block-end: 0; }
  .article-row__meta { display: grid; align-content: start; justify-items: start; gap: var(--space-md); color: var(--color-muted); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .article-row__meta time { white-space: nowrap; }
  .article-row__author { display: inline-flex; align-items: center; gap: var(--space-xs); min-width: 0; color: var(--color-ink-2); font-weight: 500; line-height: 1.25; text-decoration: none; }
  a.article-row__author { transition: color var(--dur-micro) var(--ease-out); }
  a.article-row__author:hover { color: var(--color-accent); }
  .article-row__avatar { display: grid; width: 2rem; height: 2rem; flex: 0 0 2rem; place-items: center; overflow: hidden; border: var(--rule-hair) solid var(--color-rule); border-radius: 50%; background: var(--color-paper-2); color: var(--color-muted); font-size: var(--text-xs); font-weight: 700; }
  .article-row__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .article-row__body { display: grid; align-content: start; gap: var(--space-md); min-width: 0; }
  .article-row__body h2 { max-width: 24ch; font-size: var(--text-xl); line-height: 1.3; overflow-wrap: anywhere; min-width: 0; }
  .article-row__body > p { max-width: 62ch; color: var(--color-ink-2); line-height: 1.8; }
  .article-row__foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md); }
  .article-row__tags { display: flex; flex-wrap: wrap; gap: var(--space-sm); color: var(--color-muted); font-size: var(--text-sm); }
  .article-row__tags a { white-space: nowrap; }
  .read-link { display: inline-flex; align-items: center; justify-self: end; gap: var(--space-xs); color: var(--color-accent); white-space: nowrap; }
  .read-link svg { width: 1em; height: 1em; }
  .article-row__image { display: block; aspect-ratio: 4 / 3; min-width: 0; overflow: clip; background: var(--color-paper-2); }
  .article-row__image img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-long) var(--ease-out); }
  .posts-empty { display: grid; justify-items: start; gap: var(--space-md); padding-block: var(--space-3xl); }
  .posts-empty > svg { width: var(--space-xl); color: var(--color-muted); }
  .posts-empty a { min-height: 2.75rem; padding-block: var(--space-sm); border-block-end: var(--rule-hair) solid var(--color-accent); color: var(--color-accent); white-space: nowrap; }
  @media (hover: hover) and (pointer: fine) { .article-row__body h2 a:hover, .article-row__tags a:hover { color: var(--color-accent); } .article-row__image:hover img { transform: scale(1.02); } }
  @media (min-width: 40rem) { .article-row { grid-template-columns: 9rem minmax(0, 1fr); } .article-row--with-image { grid-template-columns: 9rem minmax(0, 1fr) minmax(12rem, 0.42fr); } .article-row > .read-link { grid-column: 2 / -1; } }
  @media (min-width: 60rem) { .article-row--lead { padding-block: var(--space-2xl); } .article-row--lead .article-row__body h2 { font-size: var(--text-2xl); } }
  @media (max-width: 39.99rem) { .article-row__image { order: -1; } .article-row > .read-link { grid-column: 1; } }
</style>
