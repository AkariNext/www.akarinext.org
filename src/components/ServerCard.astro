---
import type { CmsGameServer } from "../lib/cms";

interface Props {
	server: CmsGameServer;
}

const { server } = Astro.props;
const isWeb = server.type === "web";
const isBedrock =
	server.type === "minecraft" &&
	(server.protocol?.toLowerCase().includes("bedrock") || server.port === 19132);

// Initial placeholder values
---

<server-card
    data-server={JSON.stringify(server)}
    data-is-bedrock={String(isBedrock)}
    class="server-card loading"
>
    <div class="server-header">
        <div class="server-ident">
            <div class="status-badge bg-loading">
                <div class="loader-spinner"></div>
                <span class="status-text">確認中...</span>
            </div>
            <h3 class="server-title">{server.name}</h3>
        </div>
        <div class="server-type-pill">
            {
                server.type === "minecraft"
                    ? isBedrock
                        ? "Minecraft (BE)"
                        : "Minecraft"
                    : server.type === "web"
                    ? "Web Service"
                    : server.protocol || "Service"
            }
        </div>
    </div>

    <div class="server-body">
        <div class="skeleton-content">
            <div class="skeleton-line w-3_4"></div>
            <div class="skeleton-grid">
                <div class="skeleton-box"></div>
                <div class="skeleton-box"></div>
            </div>
        </div>

        <div class="live-content" style="display: none;">
            <!-- Content will be injected via JS -->
        </div>

        {server.description && <p class="server-desc">{server.description}</p>}
    </div>

    <div class="server-footer">
        {
            isWeb ? (
                <a
                    href={
                        server.ip.startsWith("http")
                            ? server.ip
                            : `https://${server.ip}`
                    }
                    target="_blank"
                    rel="noopener noreferrer"
                    class="visit-btn"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="icon-xs"
                    >
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                        <path d="M2 12h20" />
                    </svg>{" "}
                    サイトを開く
                </a>
            ) : (
                <div class="copy-ip" data-ip={`${server.ip}:${server.port}`}>
                    <span class="ip-text">
                        {server.ip}:{server.port}
                    </span>
                    <button class="copy-btn">コピー</button>
                </div>
            )
        }
    </div>
</server-card>

<style>
  /* Hallmark · genre: editorial · component: server status · design-system: design.md · designed-as-app */
  .server-card { display: grid; min-width: 0; border-block-end: var(--rule-hair) solid var(--color-rule); background: var(--color-paper); color: var(--color-ink); }
  .server-header { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-md); padding-block: var(--space-lg); }
  .server-ident { display: grid; gap: var(--space-xs); min-width: 0; }
  .server-title { font-size: var(--text-lg); line-height: 1.25; overflow-wrap: anywhere; }
  .status-badge { display: inline-flex; align-items: center; gap: var(--space-xs); justify-self: start; color: var(--color-muted); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .bg-online { color: var(--color-success); }
  .bg-offline { color: var(--color-error); }
  .server-type-pill { flex: 0 0 auto; color: var(--color-muted); font-size: var(--text-xs); }
  .loader-spinner { width: var(--space-sm); height: var(--space-sm); border: var(--rule-medium) solid var(--color-rule); border-block-start-color: var(--color-accent); border-radius: 50%; animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .server-body { display: grid; gap: var(--space-lg); padding-block-end: var(--space-lg); }
  .skeleton-content { display: grid; gap: var(--space-sm); opacity: 0.6; }
  .skeleton-line, .skeleton-box { background: var(--color-paper-2); }
  .skeleton-line { width: 75%; height: var(--space-md); }
  .skeleton-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-sm); }
  .skeleton-box { height: var(--space-xl); }
  .server-desc { max-width: 65ch; color: var(--color-ink-2); line-height: 1.7; }
  .server-card :global(.motd-container) { display: grid; gap: var(--space-xs); padding-block: var(--space-md); border-block-start: var(--rule-hair) solid var(--color-rule); color: var(--color-ink-2); }
  .server-card :global(.server-stats-grid) { display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); border-block: var(--rule-hair) solid var(--color-rule); }
  .server-card :global(.server-stat) { display: grid; gap: var(--space-xs); padding: var(--space-md); }
  .server-card :global(.server-stat + .server-stat) { border-inline-start: var(--rule-hair) solid var(--color-rule); }
  .server-card :global(.stat-header) { display: flex; align-items: center; gap: var(--space-xs); color: var(--color-muted); font-size: var(--text-xs); text-transform: uppercase; }
  .server-card :global(.stat-icon) { width: 1rem; height: 1rem; }
  .server-card :global(.stat-value) { font-family: var(--font-display); font-size: var(--text-lg); font-variant-numeric: tabular-nums; }
  .server-card :global(.stat-sub), .server-card :global(.stat-divider) { color: var(--color-muted); font-family: var(--font-body); font-size: var(--text-sm); }
  .server-card :global(.sparkline) { width: 100%; height: var(--space-xl); color: var(--color-accent); opacity: 0.5; }
  .server-card :global(.player-list-section) { display: grid; gap: var(--space-sm); padding-block-start: var(--space-md); }
  .server-card :global(.mini-label) { color: var(--color-muted); font-size: var(--text-xs); }
  .server-card :global(.player-avatars) { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .server-card :global(.player-chip), .server-card :global(.player-head) { width: 1.75rem; height: 1.75rem; object-fit: cover; }
  .server-card :global(.more-players) { display: grid; min-width: 1.75rem; height: 1.75rem; place-items: center; color: var(--color-muted); font-size: var(--text-xs); }
  .server-card :global(.offline-placeholder) { display: grid; gap: var(--space-xs); padding-block: var(--space-lg); color: var(--color-muted); }
  .server-card :global(.server-ip-display) { display: flex; align-items: center; gap: var(--space-xs); color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .server-footer { padding-block: var(--space-md); border-block-start: var(--rule-hair) solid var(--color-rule); }
  .copy-ip { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); }
  .ip-text { overflow: hidden; color: var(--color-ink-2); font-size: var(--text-sm); text-overflow: ellipsis; white-space: nowrap; }
  .copy-btn, .visit-btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-xs); min-height: 2.75rem; padding-inline: var(--space-md); border: var(--rule-hair) solid var(--color-ink); border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-ink); cursor: pointer; white-space: nowrap; }
  @media (hover: hover) and (pointer: fine) { .copy-btn:hover, .visit-btn:hover { background: var(--color-paper-2); } }
  .copy-btn:active, .visit-btn:active { transform: translateY(1px); }
  .copy-btn:disabled, .visit-btn[aria-disabled="true"] { cursor: not-allowed; opacity: 0.5; }
  @media (prefers-reduced-motion: reduce) { .loader-spinner { animation-duration: 150ms; } }
</style>
<script>
    class ServerCardElement extends HTMLElement {
        constructor() {
            super();
            this.init();
        }

        async init() {
            let serverData: any = {};
            try {
                const rawData = this.getAttribute("data-server");
                serverData = rawData ? JSON.parse(rawData) : {};
            } catch (e) {
                console.error("Failed to parse server data", e);
                return;
            }

            if (!serverData.ip) {
                this.renderError();
                return;
            }

            const isBedrock = this.getAttribute("data-is-bedrock") === "true";

            try {
                const query = new URLSearchParams({
                    type: serverData.type,
                    ip: serverData.ip,
                    port: String(serverData.port || ""),
                    bedrock: String(isBedrock),
                });

                const res = await fetch(`/api/server-status?${query}`);
                if (!res.ok) throw new Error("API Error");
                const data = await res.json();

                this.render(data, serverData);
            } catch (e) {
                console.error("Failed to load server status", e);
                this.renderError();
            }
        }

        renderError() {
            this.classList.remove("loading");
            this.classList.add("offline");
            const statusText = this.querySelector(".status-text");
            if (statusText) {
                statusText.textContent = "不明";
                statusText.parentElement?.classList.remove("bg-loading");
                statusText.parentElement?.classList.add("bg-offline");
                const spinner =
                    statusText.parentElement?.querySelector(".loader-spinner");
                if (spinner) spinner.remove();
            }

            this.toggleContent(false);

            const liveContent = this.querySelector(".live-content");
            if (liveContent) {
                liveContent.innerHTML = `<div class="offline-placeholder"><p class="offline-msg">ステータス取得失敗</p></div>`;
            }
        }

        toggleContent(showLive: boolean) {
            const skeleton = this.querySelector(
                ".skeleton-content"
            ) as HTMLElement;
            const live = this.querySelector(".live-content") as HTMLElement;
            if (skeleton) skeleton.style.display = showLive ? "none" : "flex";
            if (live) live.style.display = showLive ? "block" : "none";
        }

        render(data: any, serverData: any) {
            this.classList.remove("loading");
            const isOnline = data.online;
            const statusBadge = this.querySelector(".status-badge");

            // Update Status Badge
            if (statusBadge) {
                statusBadge.className = `status-badge ${
                    isOnline ? "bg-online" : "bg-offline"
                }`;
                statusBadge.innerHTML = isOnline
                    ? `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> <span>ONLINE</span>`
                    : `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg> <span>OFFLINE</span>`;
            }

            const liveContent = this.querySelector(".live-content");
            if (!liveContent) return;

            if (isOnline) {
                this.classList.add("online");

                let html = "";

                // MOTD
                if (data.motd?.clean && data.motd.clean.length > 0) {
                    html += `<div class="motd-container">
                        ${data.motd.clean
                            .map(
                                (line: string) =>
                                    `<p class="motd-line">${line}</p>`
                            )
                            .join("")}
                    </div>`;
                }

                // Stats Grid
                html += `<div class="server-stats-grid">`;

                // Players
                if (serverData.type === "minecraft") {
                    html += `
                        <div class="server-stat">
                            <div class="stat-header">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stat-icon"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                <span>Players</span>
                            </div>
                            <div class="stat-value">
                                ${
                                    data.players?.online || 0
                                }<span class="stat-divider">/</span><span class="stat-sub">${
                        data.players?.max || 0
                    }</span>
                            </div>
                        </div>
                    `;
                }

                // Availability
                html += `
                    <div class="server-stat">
                        <div class="stat-header">
                             <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stat-icon"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                             <span>Uptime</span>
                        </div>
                        <div class="stat-value ${
                            data.availability > 99 ? "bg-stat-online" : ""
                        }">${
                    data.availability ?? 100
                }<span class="stat-sub">%</span></div>
                    </div>`;

                // Ping / Sparkline
                html += `
                    <div class="server-stat">
                        <div class="stat-header">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stat-icon"><path d="M2 12h5"/><path d="M12 2v10"/><path d="m19 5-7 7-7-7"/></svg>
                            <span>Ping</span>
                        </div>
                        <div class="ping-meta">
                            <span class="stat-value">${
                                data.avgPing
                            }<span class="stat-sub">ms</span></span>
                        </div>
                        ${
                            data.sparklinePath
                                ? `
                            <svg class="sparkline" viewBox="0 0 100 30" preserveAspectRatio="none">
                                <path d="${data.sparklinePath}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        `
                                : ""
                        }
                    </div>
                </div>`;

                // Player List
                if (data.players?.list && data.players.list.length > 0) {
                    html += `<div class="player-list-section">
                        <span class="mini-label">Online</span>
                        <div class="player-avatars">
                            ${data.players.list
                                .slice(0, 10)
                                .map(
                                    (p: any) => `
                                <div class="player-chip" title="${p.name}">
                                    <img src="https://minotar.net/avatar/${
                                        p.uuid || p.name
                                    }/28" class="player-head" onerror="this.src='https://minotar.net/avatar/steve/28'">
                                </div>
                            `
                                )
                                .join("")}
                            ${
                                data.players.list.length > 10
                                    ? `<div class="more-players">+${
                                          data.players.list.length - 10
                                      }</div>`
                                    : ""
                            }
                        </div>
                    </div>`;
                }

                liveContent.innerHTML = html;
            } else {
                this.classList.add("offline");
                liveContent.innerHTML = `
                    <div class="offline-placeholder">
                        <div class="server-ip-display">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-xs"><circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> 
                            ${serverData.ip}:${serverData.port}
                        </div>
                        <p class="offline-msg">サーバーは現在オフラインです</p>
                    </div>`;
            }

            this.toggleContent(true);
        }
    }

    if (!customElements.get("server-card")) {
        customElements.define("server-card", ServerCardElement);
    }

    // Copy Logic
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest(".copy-btn")) {
            const container = target.closest(".copy-ip");
            const ip = container?.getAttribute("data-ip");
            const btn = target.closest(".copy-btn");
            if (ip && btn) {
                navigator.clipboard.writeText(ip);
                const originalText = btn.textContent;
                btn.textContent = "COPIED";
                setTimeout(() => (btn.textContent = originalText), 2000);
            }
        }
    });
</script>
