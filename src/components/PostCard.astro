---
import { BookOpen, Shield } from "lucide-astro";
import { getMediaUrl, type CmsPost } from "../lib/cms";
interface Props { post: CmsPost; }
const { post } = Astro.props;
const image = getMediaUrl(post.image);
const url = `/posts/${post.slug || post.id}`;
const published = post.published_date || post.createdAt;
const formatted = new Date(published).toLocaleDateString("ja-JP", { year: "numeric", month: "short", day: "numeric" });
const author = typeof post.author === "object" && post.author ? post.author.name || post.author.username : "AkariNext";
const excerpt = post.is_spoiler ? "この記事にはネタバレが含まれています。" : post.content?.replace(/[#*_`>\[\]!]/g, "").replace(/\s+/g, " ").trim().slice(0, 110);
---
<article class="journal-card">
  <a href={url} class="journal-card__media" aria-label={`${post.title}を読む`}>
    {image ? <img src={image} alt="" loading="lazy" decoding="async" /> : <span class="journal-card__placeholder"><BookOpen aria-hidden="true" /></span>}
  </a>
  <div class="journal-card__meta"><time datetime={published}>{formatted}</time><span>{author}</span></div>
  <h2 class="journal-card__title"><a href={url}>{post.title}</a></h2>
  {excerpt && <p class="journal-card__excerpt">{excerpt}</p>}
  <div class="journal-card__foot">
    {post.is_spoiler && <span class="journal-card__spoiler"><Shield aria-hidden="true" /> ネタバレ</span>}
    {post.tags && post.tags.length > 0 && <div class="journal-card__tags">{post.tags.slice(0, 2).map((tag) => <a href={`/tags/${tag.slug}`}>#{tag.name}</a>)}</div>}
  </div>
</article>

<style>
  /* Hallmark · genre: editorial · macrostructure: Catalogue · design-system: design.md · designed-as-app */
  .journal-card { display: grid; align-content: start; gap: var(--space-sm); min-width: 0; padding-block-end: var(--space-xl); border-block-end: var(--rule-hair) solid var(--color-rule); }
  .journal-card__media { display: block; aspect-ratio: 4 / 3; min-width: 0; overflow: clip; background: var(--color-paper-2); }
  .journal-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-long) var(--ease-out); }
  .journal-card__placeholder { display: grid; width: 100%; height: 100%; place-items: center; color: var(--color-muted); }
  .journal-card__placeholder svg { width: var(--space-xl); height: var(--space-xl); }
  .journal-card__meta { display: flex; flex-wrap: wrap; gap: var(--space-sm); padding-block-start: var(--space-xs); color: var(--color-muted); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  .journal-card__title { font-size: var(--text-lg); line-height: 1.3; overflow-wrap: anywhere; min-width: 0; }
  .journal-card__excerpt { color: var(--color-ink-2); line-height: 1.75; }
  .journal-card__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-sm); color: var(--color-muted); font-size: var(--text-xs); }
  .journal-card__spoiler, .journal-card__tags, .journal-card__tags a { display: inline-flex; align-items: center; gap: var(--space-xs); white-space: nowrap; }
  .journal-card__spoiler svg { width: 1em; height: 1em; }
  @media (hover: hover) and (pointer: fine) {
    .journal-card__media:hover img { transform: scale(1.02); }
    .journal-card__title a:hover, .journal-card__tags a:hover { color: var(--color-accent); }
  }
  .journal-card a:active { transform: translateY(1px); }
  .journal-card a[aria-disabled="true"] { cursor: not-allowed; opacity: 0.5; }
</style>
