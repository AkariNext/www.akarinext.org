---
import "../styles/global.css";
import { Moon, Sun } from "lucide-astro";
import { ClientRouter } from "astro:transitions";
import { cmsClient, getMediaUrl, type CmsSettings } from "../lib/cms";

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	noindex?: boolean;
	ogType?: "website" | "article";
	structuredData?: Record<string, unknown>;
}
let globalSettings = {
	site_title: "AkariNext",
	site_logo: null as string | null,
};
try {
	const settings = await cmsClient.singleton<CmsSettings>("settings").read();
	if (settings) {
		if (settings.site_title) globalSettings.site_title = settings.site_title;
		globalSettings.site_logo = getMediaUrl(settings.site_logo) || null;
	}
} catch (error) {
	console.error("Failed to load global settings", error);
}
const { title, description: propDesc, image = "/og-image.png", canonical, noindex = false, ogType = "website", structuredData } = Astro.props;
const siteTitle =
	title && title !== globalSettings.site_title
		? `${title} | ${globalSettings.site_title}`
		: globalSettings.site_title;
const description =
	propDesc ||
	`${globalSettings.site_title} — 開発とゲームを楽しむコミュニティー`;
const siteOrigin = Astro.site || new URL("https://www.akarinext.org");
const canonicalUrl = new URL(canonical || Astro.url.pathname, siteOrigin);
const imageUrl = new URL(image, siteOrigin);
const currentPath = Astro.url.pathname;
const navItems = [
	{ label: "記事", path: "/posts" },
	{ label: "ゲーム", path: "/games" },
	{ label: "お知らせ", path: "/announcements" },
];
const isActive = (path: string) =>
	currentPath === path || currentPath.startsWith(`${path}/`) || (path === "/posts" && currentPath.startsWith("/tags/"));
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content={ogType} />
		<meta property="og:image" content={imageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		{structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />}
    <title>{siteTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=M+PLUS+1p:wght@700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
    <ClientRouter />
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const theme = savedTheme === "dark" || savedTheme === "light"
        ? savedTheme
        : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <header class="site-edge-header">
      <div class="container edge-header-inner">
        <a href="/" class="edge-brand" aria-label={`${globalSettings.site_title} ホーム`}>
          {globalSettings.site_logo && <img src={globalSettings.site_logo} alt="" class="masthead-logo" />}
          <span>{globalSettings.site_title}</span>
        </a>
        <div class="edge-actions">
          <nav class="edge-nav" aria-label="メインナビゲーション">
          {navItems.map((item) => (
            <a href={item.path} class:list={["edge-link", { active: isActive(item.path) }]} aria-current={isActive(item.path) ? "page" : undefined}>
              <span>{item.label}</span>
              {isActive(item.path) && <span class="edge-indicator" transition:name="nav-indicator" aria-hidden="true"></span>}
            </a>
          ))}
          </nav>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="配色を切り替える" transition:persist="theme-toggle">
            <Sun class="sun-icon" aria-hidden="true" /><Moon class="moon-icon" aria-hidden="true" />
          </button>
        </div>
      </div>
    </header>
    <main class="site-main"><slot /></main>
    <footer class="site-colophon">
      <div class="container colophon-inner">
        <p>{globalSettings.site_title} は、つくる人と遊ぶ人のためのコミュニティーです。記事、ゲームの記録、サーバー情報をメンバー自身の言葉で残します。</p>
        <p>© {new Date().getFullYear()} {globalSettings.site_title}</p>
        <nav aria-label="フッターナビゲーション"><a href="/privacy">プライバシー</a><a href="/terms">利用規約</a></nav>
      </div>
    </footer>
    <script is:inline>
      const syncThemeToggle = () => {
        const toggle = document.querySelector("#theme-toggle");
        if (!toggle) return;
        const isDark = document.documentElement.dataset.theme === "dark";
        toggle.setAttribute("aria-pressed", String(isDark));
        toggle.setAttribute("aria-label", isDark ? "ライトモードに切り替える" : "ダークモードに切り替える");
      };

      const bindThemeToggle = () => {
        const toggle = document.querySelector("#theme-toggle");
        if (!toggle || toggle.dataset.bound === "true") return;
        toggle.dataset.bound = "true";
        toggle.addEventListener("click", () => {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          localStorage.setItem("theme", next);
          syncThemeToggle();
        });
        syncThemeToggle();
      };

      bindThemeToggle();
      if (!window.__akariThemeLifecycleBound) {
        window.__akariThemeLifecycleBound = true;
        document.addEventListener("astro:before-swap", (event) => {
          const currentTheme = document.documentElement.dataset.theme;
          event.newDocument.documentElement.dataset.theme = currentTheme === "dark" ? "dark" : "light";
        });
        document.addEventListener("astro:page-load", bindThemeToggle);
      }
    </script>
  </body>
</html>
