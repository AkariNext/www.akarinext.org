---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { LogOut, UserRound } from "lucide-astro";
import { type CmsSettings, cmsClient, getMediaUrl } from "../lib/cms";

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	noindex?: boolean;
	ogType?: "website" | "article";
	structuredData?: Record<string, unknown>;
}
let globalSettings = {
	site_title: "AkariNext",
	site_logo: null as string | null,
};
try {
	const settings = await cmsClient.singleton<CmsSettings>("settings").read();
	if (settings) {
		if (settings.site_title) globalSettings.site_title = settings.site_title;
		globalSettings.site_logo = getMediaUrl(settings.site_logo) || null;
	}
} catch (error) {
	console.error("Failed to load global settings", error);
}
const {
	title,
	description: propDesc,
	image = "/og-image.png",
	canonical,
	noindex = false,
	ogType = "website",
	structuredData,
} = Astro.props;
const currentUser = Astro.locals.user;
const currentUserAvatar = getMediaUrl(currentUser?.avatar);
const siteTitle =
	title && title !== globalSettings.site_title
		? `${title} | ${globalSettings.site_title}`
		: globalSettings.site_title;
const description =
	propDesc ||
	`${globalSettings.site_title} — 開発とゲームを楽しむコミュニティー`;
const siteOrigin = Astro.site || new URL("https://www.akarinext.org");
const canonicalUrl = new URL(canonical || Astro.url.pathname, siteOrigin);
const imageUrl = new URL(image, siteOrigin);
const currentPath = Astro.url.pathname;
const navItems = [
	{ label: "記事", path: "/posts" },
	{ label: "シリーズ", path: "/series" },
	{ label: "ゲーム", path: "/games" },
	{ label: "お知らせ", path: "/announcements" },
];
const isActive = (path: string) =>
	currentPath === path ||
	currentPath.startsWith(`${path}/`) ||
	(path === "/posts" && currentPath.startsWith("/tags/"));
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content={ogType} />
		<meta property="og:image" content={imageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		{structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />}
    <title>{siteTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=M+PLUS+1p:wght@700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
    <ClientRouter />
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const theme = savedTheme === "dark" || savedTheme === "light"
        ? savedTheme
        : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <header class="site-edge-header">
      <div class="container edge-header-inner">
        <a href="/" class="edge-brand" aria-label={`${globalSettings.site_title} ホーム`}>
          {globalSettings.site_logo && <img src={globalSettings.site_logo} alt="" class="masthead-logo" />}
          <span>{globalSettings.site_title}</span>
        </a>
        <div class="edge-actions">
          <nav class="edge-nav" aria-label="メインナビゲーション">
          {navItems.map((item) => (
            <a href={item.path} class:list={["edge-link", { active: isActive(item.path) }]} aria-current={isActive(item.path) ? "page" : undefined}>
              <span>{item.label}</span>
              {isActive(item.path) && <span class="edge-indicator" transition:name="nav-indicator" aria-hidden="true"></span>}
            </a>
          ))}
          </nav>
          <div class="account" data-account>
            <button type="button" class="edge-account account__trigger" aria-haspopup="menu" aria-expanded="false" aria-controls="account-menu" aria-label={currentUser ? `${currentUser.name || currentUser.username} のメニュー` : "アカウントメニュー"}>
              {currentUserAvatar ? <img src={currentUserAvatar} alt="" width="28" height="28" /> : <UserRound aria-hidden="true" />}
            </button>
            <div class="account__menu" id="account-menu" role="menu" hidden>
              {currentUser ? (
                <>
                  <a class="account__item" role="menuitem" href="/dashboard">マイページ</a>
                  <a class="account__item" role="menuitem" href={`/users/${currentUser.id}`}>公開プロフィール</a>
                </>
              ) : (
                <a class="account__item" role="menuitem" href="/auth/login">ログイン</a>
              )}
              <div class="account__row">
                <span id="theme-label">配色</span>
                <div class="account__segment" role="group" aria-labelledby="theme-label">
                  <button type="button" data-theme-choice="light" aria-pressed="false">ライト</button>
                  <button type="button" data-theme-choice="dark" aria-pressed="false">ダーク</button>
                </div>
              </div>
              {currentUser && (
                <form method="POST" action="/auth/logout" data-astro-reload>
                  <button type="submit" class="account__item account__item--button account__item--danger" role="menuitem"><LogOut aria-hidden="true" />ログアウト</button>
                </form>
              )}
            </div>
          </div>
        </div>
      </div>
    </header>
    <main class="site-main"><slot /></main>
    <footer class="site-colophon">
      <div class="container colophon-inner">
        <p>{globalSettings.site_title} は、つくる人と遊ぶ人のためのコミュニティーです。記事、ゲームの記録、サーバー情報をメンバー自身の言葉で残します。</p>
        <p>© {new Date().getFullYear()} {globalSettings.site_title}</p>
        <nav aria-label="フッターナビゲーション"><a href="/privacy">プライバシー</a><a href="/terms">利用規約</a></nav>
      </div>
    </footer>
    <script is:inline>
      const syncThemeChoices = () => {
        const isDark = document.documentElement.dataset.theme === "dark";
        for (const button of document.querySelectorAll("[data-theme-choice]")) {
          const chosen = button.dataset.themeChoice === (isDark ? "dark" : "light");
          button.setAttribute("aria-pressed", String(chosen));
        }
      };

      const bindAccountMenu = () => {
        const account = document.querySelector("[data-account]");
        if (!account || account.dataset.bound === "true") return;
        account.dataset.bound = "true";

        const trigger = account.querySelector(".account__trigger");
        const menu = account.querySelector(".account__menu");

        const setOpen = (open) => {
          menu.hidden = !open;
          trigger.setAttribute("aria-expanded", String(open));
        };

        trigger.addEventListener("click", () => setOpen(menu.hidden));

        // メニューの外を触ったら閉じる。キーボードだけの人のために Escape でも閉じる
        document.addEventListener("pointerdown", (event) => {
          if (!menu.hidden && !account.contains(event.target)) setOpen(false);
        });
        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || menu.hidden) return;
          setOpen(false);
          trigger.focus();
        });
        // 中のリンクで移動したら、戻ってきたときに開いたままにしない
        menu.addEventListener("click", (event) => {
          if (event.target.closest("a")) setOpen(false);
        });

        for (const button of account.querySelectorAll("[data-theme-choice]")) {
          button.addEventListener("click", () => {
            const next = button.dataset.themeChoice;
            document.documentElement.dataset.theme = next;
            localStorage.setItem("theme", next);
            syncThemeChoices();
          });
        }
        syncThemeChoices();
      };

      bindAccountMenu();
      if (!window.__akariThemeLifecycleBound) {
        window.__akariThemeLifecycleBound = true;
        document.addEventListener("astro:before-swap", (event) => {
          const currentTheme = document.documentElement.dataset.theme;
          event.newDocument.documentElement.dataset.theme = currentTheme === "dark" ? "dark" : "light";
        });
        document.addEventListener("astro:page-load", bindAccountMenu);
      }
    </script>
  </body>
</html>
